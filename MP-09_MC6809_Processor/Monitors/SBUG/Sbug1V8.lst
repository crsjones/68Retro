FC29  170117           LBSR BYTE ;INPUT BYTE COUNT
FC2C  3402             PSHS A ;PUSH COUNT ON STACK
FC2E  2926             BVS  LODERR ;(V) C-CODE SET, ILLEGAL HEX
FC30  1700FF           LBSR IN1ADR ;INPUT LOAD ADDRESS
FC33  2921             BVS  LODERR ;(V) C-CODE SET, ADDR NOT HEX
FC35  3410             PSHS X ;PUSH ADDR ON STACK
