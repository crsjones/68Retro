FB29  8510             BITA #$10
FB2B  26CA             BNE  DBOOT
                      
FB2D  8EC000           LDX  #$C000 ;LOGICAL ADDR. = $C000
FB30  8D52             BSR LRA  ;GET 20 BIT PHYSICAL ADDR. OF LOG. ADDR.
FB32  8A10             ORA  #$10
FB34  B7F040           STA  CCCREG
FB37  1F10             TFR  X,D
FB39  43               COMA
FB3A  53               COMB
