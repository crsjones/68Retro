                      ***** "L" LOAD MIKBUG TAPE *****
                      
FC0F  8611            LOAD LDA  #$11  ;LOAD 'DC1' CASS. READ ON CODE
FC11  1701DD           LBSR OUTCH  ;OUTPUT IT TO TERMINAL PORT
FC14  7FDFE2           CLR  ECHO  ;TURN OFF ECHO FLAG
FC17  1701AD          LOAD1 LBSR ECHON ;INPUT 8 BIT BYTE WITH NO ECHO
FC1A  8153            LOAD2 CMPA #'S' ;IS IT AN "S", START CHARACTER ?
FC1C  26F9             BNE  LOAD1 ;IF NOT, DISCARD AND GET NEXT CHAR.
FC1E  1701A6           LBSR ECHON
