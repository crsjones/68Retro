FAB0  8D18            XBPLP BSR RPLSWI ;REMOVE USED ENTRY IN BP TABLE
FAB2  5A               DECB  ;$FAAC DECREMENT BP COUNTER
FAB3  26FB             BNE XBPLP ;END OF BREAKPOINT TABLE?
FAB5  39               RTS
                      
                      ***** SWI ENTRY POINT *****
                      
FAB6  1F43            SWIE TFR  S,U ;TRANSFER STACK TO USER POINTER
