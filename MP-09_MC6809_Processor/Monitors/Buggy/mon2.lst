EBEB  8DB2                            bsr disp16
EBED  BDF663                          jsr disdecode
EBF0  BDF746                          jsr disdisp       ;Disassemble instruction at PC
EBF3  9D0C                            jsr putcr
EBF5  39                              rts
                      
                      
