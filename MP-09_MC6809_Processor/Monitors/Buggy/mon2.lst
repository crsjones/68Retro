EFEF  8EF0AC                          ldx #xgetc
EFF2  9F01                            stx getchar+1   ;
EFF4  0F2F                            clr lastok
EFF6  0F30                            clr xcount
EFF8  8601                            lda #1
EFFA  972D                            sta xpacknum
EFFC  4C                              inca
EFFD  9731                            sta xmode       ;set xmode to 2.
EFFF  3596                            puls x,a,b,pc
                      
                      * O.S. routine to open output through XMODEM transfer.
F001  3416            xopout          pshs x,a,b
F003  8DB3                            bsr savevecs
F005  8EE8ED                          ldx #xrmsg
