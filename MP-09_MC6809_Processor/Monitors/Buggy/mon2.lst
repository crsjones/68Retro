F01A  102700B7                        lbeq xerror
F01E  0F30                            clr xcount
F020  8601                            lda #1
F022  9731                            sta xmode
F024  3596                            puls x,a,b,pc
                                      
                      
                      * O.S. routine to abort input through XMODEM transfer.
F026  9631            xabtin          lda xmode
F028  8102                            cmpa #2
F02A  263C                            bne xclsend
F02C  BDEF32                          jsr purge
F02F  C618                            ldb #CAN
F031  8608                            lda #8
F033  BDE476          xabtloop        jsr osputc
F036  4A                              deca
F037  26FA                            bne xabtloop    ;Send 8 CAN characters to kill transfer.
F039  8D90                            bsr rstvecs
