                      * This is the code for the T command, single step trace an instruction.
                      * Syntax T
EB5E  BDEB67          trace           jsr traceone
EB61  BDEBAF                          jsr dispregs
EB64  7EE581                          jmp cmdline
                      
EB67  1A50            traceone        orcc #$50       ;Disable the interrupts.
EB69  ECE1                            ldd ,s++        
EB6B  FD029E                          std oldpc       ;Remove saved pc from stack.
EB6E  CCEB83                          ldd #traceret
EB71  FD0287                          std firqvec+1   ;Adjust timer IRQ vector.
EB74  13                              sync            ;Synchronize on the next timer interrupt.
                                                      ;1 cycle
EB75  8E1159                          ldx #4441       ;3 cycles
EB78  301F            traceloop       leax -1,x       ;6 cycles\x4441= 39969 cycles.
EB7A  26FC                            bne traceloop   ;3 cycles/
EB7C  12                              nop             ;2 cycles.
EB7D  12                              nop             ;2 cycles.
EB7E  12                              nop             ;2 cycles.
EB7F  2102                            brn traceret    ;3 cycles.
EB81  35FF                            puls x,y,u,a,b,dp,cc,pc ;17 cycles, total=39999 20ms @ 2MHz
                                                              ;Pull all registers and execute.
                                                              ;Is timed such that next timer IRQ
                                                              ;occurs right after it.
EB83  3501            traceret        puls cc
EB85  347F                            pshs x,y,u,a,b,dp,cc;Store full register set instead of cc.
EB87  CCE510                          ldd #timerirq
EB8A  FD0287                          std firqvec+1   ;Restore timer IRQ vector.
EB8D  6E9F029E                        jmp [oldpc]
                                                      
                      
