ED0B  277C                            beq sendrec               ;CJ changed to LBEQ from BEQ?
ED0D  E61F                            ldb -1,x
ED0F  0F28                            clr temp3
ED11  C131                            cmpb #'1'
ED13  2706                            beq readrec
ED15  C139                            cmpb #'9'
ED17  2655                            bne srecerr
ED19  0C28                            inc temp3
ED1B  0F27            readrec         clr temp2+1     ;clear checksum.
ED1D  8DD1                            bsr addchk
ED1F  8002                            suba #2         ;discount the address bytes from the count.
ED21  9729                            sta temp3+1     ;Read length byte.
ED23  8DCB                            bsr addchk
ED25  3402                            pshs a
ED27  8DC7                            bsr addchk
ED29  3504                            puls b
ED2B  1E89                            exg a,b         ;Read address into d.
ED2D  FE02BF                          ldu sorg
ED30  270F                            beq rr1
ED32  FE02C1                          ldu soffs
ED35  260A                            bne rr1
ED37  3406                            pshs d          ;Sorg is nonzero and soffs is zero, now
ED39  B302BF                          subd sorg       ;set soffs
ED3C  FD02C1                          std soffs
ED3F  3506                            puls d
ED41  B302C1          rr1             subd soffs      ;Subtract the address offset.
ED44  1F02                            tfr d,y
ED46  8DA8            rr2             bsr addchk
ED48  0A29                            dec temp3+1
ED4A  2704                            beq endrec
ED4C  A7A0                            sta ,y+
ED4E  20F6                            bra rr2
ED50  0C27            endrec          inc temp2+1     ;Check checksum.
ED52  261A                            bne srecerr
ED54  0D28                            tst temp3
ED56  1027F827                        lbeq cmdline    ;Was it no S9 record?
ED5A  108C0000                        cmpy #0
ED5E  2703                            beq endrec1 
ED60  10AF6A                          sty 10,s        ;Store address into program counter.
ED63  4F              endrec1         clra
ED64  5F                              clrb
ED65  FD02BF                          std sorg        ;Reset sorg, next S loads will be normal.
ED68  FD02C1                          std soffs
ED6B  7EE581                          jmp cmdline
ED6E  9D18            srecerr         jsr xabortin
ED70  8EE8BE                          ldx #smsg       ;Error in srecord, display message.
ED73  BDE507                          jsr outcount
ED76  9D0C                            jsr putcr
ED78  7EE581                          jmp cmdline
ED7B  BDE9AC          setsorg         jsr scanhex     ;Set S record origin.
ED7E  FD02BF                          std sorg
ED81  4F                              clra 
ED82  5F                              clrb
ED83  FD02C1                          std soffs
ED86  7EE581                          jmp cmdline
                      * Send a memory region as S-records.
ED89  CC0100          sendrec         ldd #$100       ;Scan address and length parameter.
ED8C  BDE9CF                          jsr scan2parms
ED8F  FC02BF                          ldd sorg
ED92  2709                            beq ss1
ED94  FC02A0                          ldd addr
ED97  B302BF                          subd sorg
ED9A  FD02C1                          std soffs       ;Compute offset for origin.
ED9D  FC02A2          ss1             ldd length      
EDA0  2748                            beq endss       ;All bytes sent?
EDA2  10830010                        cmpd #16
EDA6  2502                            blo ss2
EDA8  C610                            ldb #16         ;If more than 16 left, then send 16.
EDAA  D724            ss2             stb temp
EDAC  50                              negb
EDAD  FE02A2                          ldu length
EDB0  33C5                            leau b,u
EDB2  FF02A2                          stu length      ;Discount line length from length.
EDB5  C653                            ldb #'S'
EDB7  9D03                            jsr putchar
EDB9  C631                            ldb #'1'
EDBB  9D03                            jsr putchar
EDBD  0F25                            clr temp+1      ;Clear check sum
EDBF  D624                            ldb temp
EDC1  CB03                            addb #3
EDC3  8D30                            bsr checkout    ;Output byte b as hex and add to check sum.
EDC5  FC02A0                          ldd addr
EDC8  1F02                            tfr d,y
EDCA  B302C1                          subd soffs
EDCD  1E89                            exg a,b
EDCF  8D24                            bsr checkout
EDD1  1E89                            exg a,b
EDD3  8D20                            bsr checkout    ;Output address (add into check sum)
EDD5  E6A0            ss3             ldb ,y+
EDD7  8D1C                            bsr checkout
EDD9  0A24                            dec temp
EDDB  26F8                            bne ss3
EDDD  10BF02A0                        sty addr
EDE1  D625                            ldb temp+1
EDE3  53                              comb
EDE4  8D0F                            bsr checkout    ;Output checksum byte.
EDE6  9D0C                            jsr putcr
EDE8  20B3                            bra ss1
EDEA  8EE8D0          endss           ldx #lastrec
EDED  BDE507                          jsr outcount
EDF0  9D0C                            jsr putcr
EDF2  7EE581                          jmp cmdline
                      * Output byte in register B and add it into check sum at temp+1
EDF5  3402            checkout        pshs a
EDF7  1F98                            tfr b,a
EDF9  DB25                            addb temp+1
EDFB  D725                            stb temp+1
EDFD  BDE96D                          jsr outbyte
EE00  3502                            puls a
EE02  39                              rts
                      
                      * This is the code for the M command, move memory region.
                      * Syntax: Maddr1,addr2,length
EE03  8E0201          move            ldx #linebuf+1
