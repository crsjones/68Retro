F045  39                              rts             
                      
                      * O.S. routine to close output through XMODEM transfer.
F046  9631            xclsout         lda xmode 
F048  8101                            cmpa #1
F04A  261C                            bne xclsend
F04C  0D30                            tst xcount
F04E  270C                            beq xclsdone
F050  8680                            lda #128
F052  9030                            suba xcount
F054  F602CA          xclsloop        ldb filler
F057  8D1A                            bsr xputc   
F059  4A                              deca
F05A  26F8                            bne xclsloop    ;Transfer filler chars to force block out.
F05C  BDEF01          xclsdone        jsr xsendeot    ;Send EOT
F05F  10270072                        lbeq xerror
F063  BDEFCB                          jsr rstvecs
F066  0F31                            clr xmode
F068  39              xclsend         rts     
                      
                      * O.S. routine to close input through XMODEM, by gobbling up the remaining
                      * bytes.
F069  D631            xclsin          ldb xmode
F06B  C102                            cmpb #2
F06D  26F9                            bne xclsend
F06F  9D03                            jsr putchar
