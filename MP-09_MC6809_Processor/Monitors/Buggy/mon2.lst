EC73  39                              rts
                      
                      * Arm the breakponts, this is replace the byte at the breakpoint address
                      * with an SWI instruction.
EC74  8E02BC          arm             ldx #bpaddr+brkpoints*3
EC77  8609                            lda #brkpoints+1  ;Arm them in reverse order of disarming.
EC79  EE84            arm1            ldu ,x       ;Get address in u.
EC7B  270D                            beq arm2
EC7D  E6C4                            ldb ,u
EC7F  E702                            stb 2,x
