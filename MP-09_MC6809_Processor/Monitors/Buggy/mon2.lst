EE09  1027F7D4                        lbeq unk
EE0D  DD28                            std temp3
EE0F  BDE984                          jsr skipspace
EE12  C12C                            cmpb #','
EE14  1026F7C9                        lbne unk
EE18  BDE9AC                          jsr scanhex
EE1B  1027F7C2                        lbeq unk
EE1F  1F03                            tfr d,u
EE21  BDE984                          jsr skipspace
EE24  C12C                            cmpb #','
EE26  1026F7B7                        lbne unk
EE2A  BDE9AC                          jsr scanhex
EE2D  1027F7B0                        lbeq unk
EE31  1F02                            tfr d,y         ;Read the argument separated by commas
EE33  9E28                            ldx temp3       ;src addr to x, dest addr to u, length to y
                                                      ;Don't tolerate syntax deviations.
EE35  A680            mvloop          lda ,x+
EE37  A7C0                            sta ,u+
EE39  313F                            leay -1,y
EE3B  26F8                            bne mvloop      ;Perform the block move.
EE3D  7EE581                          jmp cmdline
                                      
                      
                      * This is the code for the F command, find byte/ascii string in memory.
                      * Syntax: Faddr bytes or Faddr "ascii"
EE40  8E0201          find            ldx #linebuf+1
EE43  BDE9AC                          jsr scanhex
EE46  1F02                            tfr d,y         ;Scan the start address.
EE48  BDE984                          jsr skipspace
EE4B  C122                            cmpb #'"'
EE4D  2611                            bne findhex
EE4F  CE0200                          ldu #linebuf    ;Quote found, so scan for quoted string.
EE52  4F                              clra
EE53  E680            fstrloop        ldb ,x+
EE55  271F                            beq startsrch   ;End of line without final quote.
EE57  C122                            cmpb #'"'
EE59  271B                            beq startsrch   ;End quote found
EE5B  E7C0                            stb ,u+
EE5D  4C                              inca
EE5E  20F3                            bra fstrloop
EE60  CE0200          findhex         ldu #linebuf    ;Convert string of hex bytes.
EE63  301F                            leax -1,x       ;String will be stored at start of line
EE65  4F                              clra            ;buffer and may overwrite part of the
EE66  3402            fhexloop        pshs a          ;already converted string.
EE68  BDE9E7                          jsr scanbyte
EE6B  1F89                            tfr a,b
EE6D  3502                            puls a
EE6F  2705                            beq startsrch
EE71  E7C0                            stb ,u+
EE73  4C                              inca
EE74  20F0                            bra fhexloop
EE76  4D              startsrch       tsta            ;Start searching, start addr in Y, 
                                                      ;string starts at linebuf, length A
EE77  1027F706                        lbeq cmdline    ;Quit with zero length string.
EE7B  0F28                            clr temp3
EE7D  9729                            sta temp3+1
EE7F  1F21            srchloop        tfr y,x
EE81  9629                            lda temp3+1
EE83  8CE100                          cmpx #$e100
EE86  2409                            bcc srch1
EE88  3086                            leax a,x
EE8A  8CE000                          cmpx #$e000     ;Stop at I/O addresses.
EE8D  1024F6F0                        lbcc cmdline
EE91  1F21            srch1           tfr y,x
EE93  CE0200                          ldu #linebuf
EE96  E680            srch2           ldb ,x+
EE98  E1C0                            cmpb ,u+
EE9A  2614                            bne srch3       ;Not equal, try next address.
EE9C  4A                              deca 
EE9D  26F7                            bne srch2
EE9F  1F20                            tfr y,d
EEA1  BDE97B                          jsr outd        ;String found
EEA4  9D0C                            jsr putcr
EEA6  0C28                            inc temp3
EEA8  9628                            lda temp3
EEAA  8110                            cmpa #$10
EEAC  1027F6D1                        lbeq cmdline    ;If 10 matches found, just stop.
EEB0  3121            srch3           leay 1,y
EEB2  20CB                            bra srchloop
                      
                      * Send the contents of the xmodem buffer and get it acknowledged, zero flag
                      * is set if transfer aborted.
EEB4  C601            xsendbuf        ldb #SOH
EEB6  BDE476                          jsr osputc      ;Send SOH
EEB9  D62D                            ldb xpacknum
EEBB  BDE476                          jsr osputc      ;Send block number.
EEBE  53                              comb
EEBF  BDE476                          jsr osputc      ;and its complement.
EEC2  0F2E                            clr xsum
EEC4  8680                            lda #128
EEC6  8E0100                          ldx #buf0
EEC9  E684            xsloop          ldb ,x
EECB  DB2E                            addb xsum
EECD  D72E                            stb xsum        
EECF  E680                            ldb ,x+
EED1  BDE476                          jsr osputc
EED4  4A                              deca
EED5  26F2                            bne xsloop      ;Send the buffer contents.
EED7  D62E                            ldb xsum
EED9  BDE476                          jsr osputc      ;Send the check sum
EEDC  BDE45F          waitack         jsr osgetc
EEDF  C118                            cmpb #CAN
EEE1  270C                            beq xsabt       ;^X for abort.
EEE3  C115                            cmpb #NAK
EEE5  27CD                            beq xsendbuf    ;Send again if NAK
EEE7  C106                            cmpb #ACK
EEE9  26F1                            bne waitack
EEEB  0C2D                            inc xpacknum
EEED  1CFB            xsok            andcc #$fb      ;Clear zero flag after ACK
EEEF  39              xsabt           rts
                      
                      * Start an XMODEM send session.
EEF0  C601            xsendinit       ldb #1
EEF2  D72D                            stb xpacknum    ;Initialize block number.
EEF4  BDE45F          waitnak         jsr osgetc
EEF7  C118                            cmpb #CAN
EEF9  27F4                            beq xsabt      ;If ^X exit with zero flag.
EEFB  C115                            cmpb #NAK
EEFD  27EE                            beq xsok
EEFF  20F3                            bra waitnak    ;Wait until NAK received.
                      
                      * Send ETX and wait for ack.
EF01  C604            xsendeot        ldb #EOT
EF03  BDE476                          jsr osputc
EF06  BDE45F          waitack2        jsr osgetc
EF09  C118                            cmpb #CAN
EF0B  27E2                            beq xsabt
EF0D  C115                            cmpb #NAK
EF0F  27F0                            beq xsendeot
EF11  C106                            cmpb #ACK
EF13  27D8                            beq xsok
EF15  20EF                            bra waitack2
                      
                      * Read character into B with a timeout of A seconds,  Carry set if timeout.
EF17  48              gettimeout      asla
EF18  C632                            ldb #50
EF1A  3D                              mul
EF1B  1F98                            tfr b,a
EF1D  9B2C                            adda timer+2
EF1F  BDE46A          gt1             jsr osgetpoll
EF22  5D                              tstb
EF23  2607                            bne gtexit
EF25  912C                            cmpa timer+2
EF27  26F6                            bne gt1         
EF29  1A01                            orcc #$1
EF2B  39                              rts
EF2C  BDE45F          gtexit          jsr osgetc
EF2F  1CFE                            andcc #$fe
EF31  39                              rts
                      
                      * Wait until line becomes quiet.
EF32  8603            purge           lda #3
EF34  BDEF17                          jsr gettimeout
EF37  24F9                            bcc purge
EF39  39                              rts
                      
                      * Receive an XMODEM block and wait till it is OK, Z set if etx.
EF3A  8603            xrcvbuf         lda #3
EF3C  0D2F                            tst lastok
EF3E  2709                            beq sendnak
EF40  C606                            ldb #ACK
EF42  BDE476                          jsr osputc      ;Send an ack.
EF45  8605                            lda #5
EF47  2005                            bra startblock
EF49  C615            sendnak         ldb #NAK
EF4B  BDE476                          jsr osputc      ;Send a NAK
EF4E  0F2F            startblock      clr lastok
EF50  8DC5                            bsr gettimeout
EF52  8603                            lda #3
EF54  25F3                            bcs sendnak     ;Keep sending NAKs when timed out.
EF56  C104                            cmpb #EOT
EF58  2753                            beq xrcveot     ;End of file reached, acknowledge EOT.
EF5A  C101                            cmpb #SOH
EF5C  264A                            bne purgeit     ;Not, SOH, bad block.
EF5E  8601                            lda #1
EF60  8DB5                            bsr gettimeout
EF62  2544                            bcs purgeit
EF64  D12D                            cmpb xpacknum   ;Is it the right block?
EF66  2707                            beq xr1
EF68  5C                              incb
EF69  D12D                            cmpb xpacknum   ;Was it the previous block.
EF6B  263B                            bne purgeit     
EF6D  0C2F                            inc lastok
EF6F  D72E            xr1             stb xsum
EF71  8601                            lda #1
EF73  8DA2                            bsr gettimeout
EF75  2531                            bcs purgeit
EF77  53                              comb
EF78  D12E                            cmpb xsum       ;Is the complement of the block number OK
EF7A  262C                            bne purgeit
EF7C  8E0100                          ldx #buf0
EF7F  0F2E                            clr xsum
EF81  8601            xrloop          lda #1
EF83  8D92                            bsr gettimeout
EF85  2521                            bcs purgeit
EF87  E780                            stb ,x+
EF89  DB2E                            addb xsum
EF8B  D72E                            stb xsum
EF8D  8C0180                          cmpx #buf0+128
EF90  26EF                            bne xrloop       ;Get the data bytes.
EF92  8601                            lda #1
EF94  17FF80                          lbsr gettimeout           ;CJ changed from BSR to LBSR?
EF97  250F                            bcs purgeit
EF99  D12E                            cmpb xsum
EF9B  260B                            bne purgeit     ;Check the check sum.
EF9D  0D2F                            tst lastok
EF9F  2699                            bne xrcvbuf     ;Block was the previous block, get next one
EFA1  0C2F                            inc lastok
EFA3  0C2D                            inc xpacknum
EFA5  1CFB                            andcc #$fb
EFA7  39                              rts
EFA8  BDEF32          purgeit         jsr purge
EFAB  209C                            bra sendnak
EFAD  8603            xrcveot         lda #3          ;EOT was received.
EFAF  C606                            ldb #ACK
EFB1  BDE476          ackloop         jsr osputc
EFB4  4A                              deca
EFB5  26FA                            bne ackloop     ;Send 3 acks in a row.
EFB7  39                              rts
                      
                      
EFB8  9E01            savevecs        ldx getchar+1
EFBA  BF02C3                          stx oldgetc
