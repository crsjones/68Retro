FF56  270D                            beq asmend
FF58  BDFA08                          jsr asminstr
FF5B  20C6                            bra asmloop
                      
FF5D  FC02CE          next            ldd nxtadd
FF60  FD02A0                          std addr
FF63  20BE                            bra asmloop
                      
FF65  0F32            asmend          clr disflg
FF67  7EE581                          jmp cmdline
                      
                      * Jump table for monitor routines that are usable by other programs.
FFC0                                  org $ffc0
FFC0  7EE96D                          jmp outbyte
FFC3  7EE97B                          jmp outd
FFC6  7EE9E7                          jmp scanbyte
FFC9  7EE9AC                          jmp scanhex
FFCC  7EF9B8                          jmp scanfact
FFCF  7EFA08                          jmp asminstr
                      
                      * Interrupt vector addresses at top of ROM. Most are vectored through jumps
                      * in RAM.
FFF2                                  org $fff2
FFF2  0280                            fdb swi3vec
FFF4  0283                            fdb swi2vec
FFF6  0286                            fdb firqvec
FFF8  0289                            fdb irqvec
FFFA  028C                            fdb swivec
FFFC  028F                            fdb nmivec
FFFE  E400                            fdb reset
                      
0000                                  end
