                      * Disarm the breakpoints, this is replace the SWI instructions with the
                      * original byte.
EC5A  8E02A4          disarm          ldx #bpaddr
EC5D  8609                            lda #brkpoints+1
EC5F  EE81            disarm1         ldu ,x++
EC61  E680                            ldb ,x+         ;Get address in u, byte in b
EC63  11830000                        cmpu #0
EC67  2702                            beq disarm2
EC69  E7C4                            stb ,u
