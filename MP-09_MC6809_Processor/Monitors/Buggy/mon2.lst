F082  0F30                            clr xcount
F084  3460                            pshs y,u
F086  BDEEB4                          jsr xsendbuf
F089  10270048                        lbeq xerror
F08D  3560                            puls y,u
F08F  3596            xputc1          puls x,a,b,pc
                      
