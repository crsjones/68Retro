                      ;Buggy machine language monitor and rudimentary O.S. version 1.0
                      ;mon2.asm
                      * Memory map of SBC
                      * $0-$40 Zero page variables reserved by monitor and O.S.
                      * $40-$FF Zero page portion for user programs.
                      * $100-$17F Xmodem buffer 0, terminal input buffer,
                      * $180-$1FF Xmodem buffer 1, terminal output buffer.
                      * $200-$27F Terminal input line.
                      * $280-$2FF Variables reserved by monitor and O.S.
                      * $300-$400 System stack.
                      * $400-$7FFF RAM for user programs and data.
                      * $8000-$DFFF PROM for user programs.
                      * $E000-$E1FF I/O addresses.
                      * $E200-$E3FF Reserved.
                      * $E400-$FFFF Monitor ROM
0000                   SETDP 0
                      * Reserved Zero page addresses
0000                                  org $0000
                      * First the I/O routine vectors.
0000                  getchar         rmb 3           ;Jump to getchar routine.
0003                  putchar         rmb 3           ;Jump to putchar routine.
0006                  getline         rmb 3           ;Jump to getline routine.
0009                  putline         rmb 3           ;Jump to putline routine.
000C                  putcr           rmb 3           ;Jump to putcr routine.
000F                  getpoll         rmb 3           ;Jump to getpoll routine.
0012                  xopenin         rmb 3           ;Jump to xopenin routine.
0015                  xopenout        rmb 3           ;Jump to xopenout routine.
0018                  xabortin        rmb 3           ;Jump to xabortin routine.
001B                  xclosein        rmb 3           ;Jump to xclosein routine.
001E                  xcloseout       rmb 3           ;Jump to xcloseout routine.
0021                  delay           rmb 3           ;Jump to delay routine.
                      
                      *Next the system variables in the zero page.
0024                  temp            rmb 2            ;hex scanning/disasm
0026                  temp2           rmb 2            ;Hex scanning/disasm
0028                  temp3           rmb 2            ;Used in Srecords, H command
002A                  timer           rmb 3            ;3 byte timer, incremented every 20ms
002D                  xpacknum        rmb 1            ;Packet number for XMODEM block,
002E                  xsum            rmb 1            ;XMODEM checksum
002F                  lastok          rmb 1            ;flag to indicate last block was OK
0030                  xcount          rmb 1            ;Count of characters in buffer.
0031                  xmode           rmb 1            ;XMODEM mode, 0 none, 1 out, 2 in.
0032                  disflg          rmb 1
                      
                      * I/O buffers.
0080                  buflen          equ 128         ;Length of input line buffer.
0100                                  org $100
0100                  buf0            rmb 128         ;Xmodem buffer 0, serial input buffer.
0180                  buf1            rmb 128         ;Xmodem buffer 1, serial output buffer.
0200                  linebuf         rmb buflen      ;Input line buffer.
                      
                      
                      * Interrupt vectors (start at $280)
                      * All interrupts except RESET are vectored through jumps.
                      * FIRQ is timer interrupt, IRQ is ACIA interrupt.
0280                  swi3vec         rmb 3
0283                  swi2vec         rmb 3
0286                  firqvec         rmb 3
0289                  irqvec          rmb 3
028C                  swivec          rmb 3
028F                  nmivec          rmb 3
0292                  xerrvec         rmb 3           ;Error handler for XMODEM error.
0295                  exprvec         rmb 3           ;Expression evaluator in assembler.
0298                  asmerrvec       rmb 3           ;Error handler for assembler errors.
029B                  pseudovec       rmb 3           ;Vector for asm pseudo instructions.
                      
                      * Next the non zero page system variables.
029E                  oldpc           rmb 2           ;Saved pc value for J command.
02A0                  addr            rmb 2           ;Address parameter.
02A2                  length          rmb 2           ;Length parameter.
                      
0008                  brkpoints       equ 8           ;Number of settable breakpoints. 
02A4                  bpaddr          rmb brkpoints*3 ;Address and byte for each break point.
02BC                  stepbp          rmb 3           ;Address of P command break point.
                      
02BF                  sorg            rmb 2           ;Origin address of S record entry.
02C1                  soffs           rmb 2           ;Offset load adrr-addr in record
                      
02C3                  oldgetc         rmb 2           ;Old getchar address.
02C5                  oldputc         rmb 2           ;Old putchar address.
02C7                  oldputcr        rmb 2           ;Old putcr address.
02C9                  lastterm        rmb 1           ;Last terminating character.
02CA                  filler          rmb 1           ;Filler at end of XMODEM file.
02CB                  xmcr            rmb 1           ;end-of-line characters for XMODEM send.
02CC                  savesp          rmb 2           ;Save sp to restore it on error.
02CE                  nxtadd          rmb 2
                      
                      * Following variables are used by assembler/disassembler.
02D0                  prebyte         rmb 1
02D1                  opc1            rmb 1
02D2                  opcode          rmb 1
02D3                  postbyte        rmb 1
02D4                  amode           rmb 1
02D5                  operand         rmb 2           
02D7                  mnembuf         rmb 5           ;Buffer to store capitalized mnemonic.
02DC                  opsize          rmb 1           ;SIze (in bytes) of extra oeprand (0--2)
02DD                  uncert          rmb 1           ;Flag to indicate that op is unknown.
02DE                  dpsetting       rmb 2
                      
02E0                  endvars         equ *
                      
0400                  ramstart        equ $400        ;first free RAM address.
                      
8000                  ramtop  equ $8000       ;top of RAM.
                      
                      * I/O port addresses
E000                  aciactl         equ $e000       ;Control port of ACIA
E000                  aciasta         equ $e000       ;Status port of ACIA
E001                  aciadat         equ $e001       ;Data port of ACIA
                      
                      * ASCII control characters.
0001                  SOH             equ 1
0004                  EOT             equ 4
0006                  ACK             equ 6
0008                  BS              equ 8
0009                  TAB             equ 9
000A                  LF              equ 10
000D                  CR              equ 13
0015                  NAK             equ 21
0018                  CAN             equ 24
007F                  DEL             equ 127
                      
00DF                  CASEMASK        equ $DF         ;Mask to make lowercase into uppercase.
                      
                      * Monitor ROM starts here.
E400                                  org $E400
                      
E400  1AFF            reset   orcc #$FF       ;Disable interrupts.
E402  4F                              clra
E403  1F8B                            tfr a,dp        ;Set direct page register to 0.
E405  0F32                            clr disflg
E407  10CE0400                        lds #ramstart
E40B  8EE525                          ldx #intvectbl
E40E  CE0280                          ldu #swi3vec
E411  C61E                            ldb #osvectbl-intvectbl
E413  8D37                            bsr blockmove   ;Initialize interrupt vectors from ROM.
E415  8EE543                          ldx #osvectbl
E418  CE0000                          ldu #0
E41B  C624                            ldb #endvecs-osvectbl
E41D  8D2D                            bsr blockmove   ;Initialize I/O vectors from ROM.
E41F  8D33                            bsr initacia    ;Initialize serial port.
E421  1C00                            andcc #$0       ;Enable interrupts
                      * Put the 'saved' registers of the program being monitored on top of the
                      * stack. There are 12 bytes on the stack for cc,b,a,dp,x,y,u and pc
                      * pc is initialized to $400, the rest to zero.
E423  8E0000                          ldx #0
E426  1F12                            tfr x,y
E428  CE0400                          ldu #ramstart
E42B  3450                            pshs x,u
E42D  3430                            pshs x,y
E42F  3430                            pshs x,y  
E431  8E029E                          ldx #oldpc
E434  C642                            ldb #endvars-oldpc
E436  6F80            clvar   clr ,x+
E438  5A                              decb
E439  26FB                            bne clvar       ;Clear the variable area.
E43B  CC1A03                          ldd #$1A03
E43E  FD02CA                          std filler      ;Set XMODEM filler and end-of-line.
E441  8EE85E                          ldx #welcome
E444  BDE507                          jsr outcount
E447  9D0C                            jsr putcr       ;Print a welcome message.
E449  7EE581                          jmp cmdline
                      * Block move routine, from X to U length B. Modifies them all and A. 
E44C  A680            blockmove       lda ,x+
E44E  A7C0                            sta ,u+
E450  5A                              decb
E451  26F9                            bne blockmove
E453  39                              rts
                      
                      * Initialize serial communications port, buffers, interrupts.
E454  C603            initacia        ldb #$03     ;reset ACIA
E456  F7E000                          stb aciactl
E459  C615                            ldb #%00010101   ;tx interrupts disabled
E45B  F7E000                          stb aciactl      ;set ACIA control register
E45E  39                              rts
                      
                      * O.S. routine to read a character into B register.
E45F  F6E000          osgetc          ldb aciasta
E462  C501                            bitb #$01
E464  27F9                            beq osgetc
E466  F6E001                          ldb aciadat
E469  39                              rts
                      
                      ;O.S. routine to check if there is a character ready to be read.
E46A  F6E000          osgetpoll       ldb aciasta
E46D  C501                            bitb #$01
E46F  2602                            bne poltrue
E471  5F                              clrb
E472  39                              rts
E473  C6FF            poltrue         ldb #$ff
E475  39                              rts
                      
                      * O.S. routine to write the character in the B register.
E476  3402            osputc          pshs a
E478  B6E000          putcloop        lda aciasta
E47B  8502                            bita #$02
E47D  27F9                            beq putcloop
E47F  F7E001                          stb aciadat
E482  3502                            puls a
E484  39                              rts
                      
                      * O.S. routine to read a line into memory at address X, at most B chars
                      * long, return actual length in B. Permit backspace editing.
E485  3412            osgetl          pshs a,x
E487  D724                            stb temp
E489  4F                              clra
E48A  9D00            osgetl1         jsr getchar
E48C  C47F                            andb #$7F
E48E  C108                            cmpb #BS
E490  2704                            beq backsp
E492  C17F                            cmpb #DEL
E494  2614                            bne osgetl2
E496  4D              backsp          tsta                  ;Recognize BS and DEL as backspace key.
E497  27F1                            beq osgetl1           ;ignore if line already zero length.
E499  C608                            ldb #BS
E49B  9D03                            jsr putchar
E49D  C620                            ldb #' '
E49F  9D03                            jsr putchar
E4A1  C608                            ldb #BS               ;Send BS,space,BS. This erases last
E4A3  9D03                            jsr putchar           ;character on most terminals.
E4A5  301F                            leax -1,x             ;Decrement address.
E4A7  4A                              deca
E4A8  20E0                            bra osgetl1
E4AA  C10D            osgetl2         cmpb #CR
E4AC  270D                            beq newline
E4AE  C10A                            cmpb #LF
E4B0  2613                            bne osgetl3           ;CR or LF character ends line.
E4B2  F602C9                          ldb lastterm
E4B5  C10D                            cmpb #CR
E4B7  27D1                            beq osgetl1           ;Ignore LF if it comes after CR
E4B9  C60A                            ldb #LF               
E4BB  F702C9          newline         stb lastterm
E4BE  9D0C                            jsr putcr             
E4C0  1F89                            tfr a,b               ;Move length to B
E4C2  3512                            puls a,x              ;restore registers.
E4C4  39                              rts                   ;<--- Here is the exit point.
E4C5  C109            osgetl3         cmpb #TAB
E4C7  270F                            beq dotab
E4C9  C120                            cmpb #' '
E4CB  25BD                            blo osgetl1           ;Ignore control characters.
E4CD  9124                            cmpa temp
E4CF  27B9                            beq osgetl1           ;Ignore char if line full.
E4D1  9D03                            jsr putchar           ;Echo the character.
E4D3  E780                            stb ,x+               ;Store it in memory.
E4D5  4C                              inca
E4D6  20B2                            bra osgetl1
E4D8  C620            dotab           ldb #' '
E4DA  9124                            cmpa temp
E4DC  27AC                            beq osgetl1
E4DE  9D03                            jsr putchar
E4E0  E780                            stb ,x+
E4E2  4C                              inca
E4E3  8507                            bita #7                ;Insert spaces until length mod 8=0
E4E5  26F1                            bne dotab
E4E7  20A1                            bra osgetl1 
                      
                      * O.S. routine to write a line starting at address X, B chars long.
E4E9  3416            osputl          pshs a,b,x
E4EB  1F98                            tfr b,a
E4ED  4D                              tsta
E4EE  2707                            beq osputl1
E4F0  E680            osputl2         ldb ,x+
E4F2  9D03                            jsr putchar
E4F4  4A                              deca
E4F5  26F9                            bne osputl2
E4F7  3516            osputl1         puls a,b,x
E4F9  39                              rts
                      
                      * O.S. routine to terminate a line.
E4FA  3404            oscr            pshs b
E4FC  C60D                            ldb #CR
E4FE  9D03                            jsr putchar
E500  C60A                            ldb #LF
E502  9D03                            jsr putchar     ;Send the CR and LF characters.
E504  3504                            puls b
E506  39                              rts
                      
                      * Output a counted string at addr X
E507  3414            outcount        pshs x,b
E509  E680                            ldb ,x+
E50B  9D09                            jsr putline
E50D  3514                            puls x,b
E50F  39                              rts
                      
E510  0C2C            timerirq        inc timer+2
E512  2608                            bne endirq
E514  0C2B                            inc timer+1
E516  2604                            bne endirq
E518  0C2A                            inc timer
E51A  3B                              rti
E51B  12              aciairq         nop
E51C  3B              endirq          rti
                      
                      * Wait D times 20ms.
E51D  D32B            osdly           addd timer+1
E51F  10932B          dlyloop         cmpd timer+1
E522  26FB                            bne dlyloop
E524  39                              rts             
                      
                      * This table will be copied to the interrupt vector area in RAM.
E525  7EE51C          intvectbl       jmp endirq
E528  7EE51C                          jmp endirq
E52B  7EE510                          jmp timerirq
E52E  7EE51B                          jmp aciairq
E531  7EE572                          jmp unlaunch
E534  7EE51C                          jmp endirq
E537  7EF0E5                          jmp xerrhand
E53A  7EF99A                          jmp expr
E53D  7E0298                          jmp asmerrvec
E540  7EFBC9                          jmp pseudo
                      * And this one to the I/O vector table.
E543  7EE45F          osvectbl        jmp osgetc
E546  7EE476                          jmp osputc
E549  7EE485                          jmp osgetl
E54C  7EE4E9                          jmp osputl
E54F  7EE4FA                          jmp oscr
E552  7EE46A                          jmp osgetpoll
E555  7EEFDE                          jmp xopin
E558  7EF001                          jmp xopout
E55B  7EF026                          jmp xabtin
E55E  7EF069                          jmp xclsin
E561  7EF046                          jmp xclsout
E564  7EE51D                          jmp osdly
E567                  endvecs         equ *
                                      
                      * The J command returns here.
E567  3410            stakregs        pshs x               ;Stack something where the pc comes
                      ;               pshs ccr,b,a,dp,x,y,u ;Stack the normal registers.
E569  347F                            pshs cc,b,a,dp,x,y,u ;Stack the normal registers.
                      
E56B  BE029E                          ldx oldpc       
E56E  AF6A                            stx 10,s             ;Stack the old pc value.
E570  2007                            bra unlaunch1
                      * The G and P commands return here through a breakpoint.
                      * Registers are already stacked.
E572  EC6A            unlaunch        ldd 10,s
E574  830001                          subd #1
E577  ED6A                            std 10,s             ;Decrement pc before breakpoint
E579  1C00            unlaunch1       andcc #$0            ;reenable the interrupts.
E57B  BDEC5A                          jsr disarm           ;Disarm the breakpoints.
E57E  BDEBAF                          jsr dispregs         
E581  9D1E            cmdline         jsr xcloseout
E583  10FF02CC                        sts savesp
E587  C62E                            ldb #'.'
E589  9D03                            jsr putchar
E58B  8E0200                          ldx #linebuf
E58E  C680                            ldb #buflen
E590  9D06                            jsr getline
E592  5D                              tstb
E593  27EC                            beq cmdline          ;Ignore line if it is empty
E595  3A                              abx
E596  6F84                            clr ,x               ;Make location after line zero.
E598  8E0200                          ldx #linebuf
E59B  E680                            ldb ,x+
E59D  C4DF                            andb #CASEMASK       ;Make 1st char uppercase.
E59F  C041                            subb #'A'            
E5A1  253E                            bcs unk
E5A3  C11A                            cmpb #26
E5A5  243A                            bcc unk              ;Unknown cmd if it is not a letter.
E5A7  8EE5AD                          ldx #cmdtab
E5AA  58                              aslb                  ;Index into command table.
E5AB  6E95                            jmp [b,x]
                      
E5AD  FF18EC90EAF0EA00 cmdtab          fdb asm,break,calc,dump
E5B5  EA5AEE40EB24E5EE                 fdb enter,find,go,help
E5BD  EADEEB33E5E1E5E1                 fdb inp,jump,unk,unk
E5C5  EE03E5E1E5E1EB52                 fdb move,unk,unk,prog
E5CD  E5E1EBF6ECFEEB5E                 fdb unk,regs,srec,trace
E5D5  F93CE5E1E5E1F0EC                 fdb unasm,unk,unk,xmodem
E5DD  E5E1E5E1                        fdb unk,unk
                      
                      * Unknown command handling routine.
E5E1  9D18            unk             jsr xabortin
E5E3  8EE87B                          ldx #unknown
E5E6  BDE507                          jsr outcount
E5E9  9D0C                            jsr putcr
E5EB  7EE581                          jmp cmdline
                      
E5EE  8EE5FD          help            ldx #mhelp      ;Print a help message.
E5F1  E680            help1           ldb ,x+
E5F3  2705                            beq endhlp
E5F5  17FE7E                          lbsr osputc
E5F8  20F7                            bra help1               
E5FA  7EE581          endhlp          jmp cmdline
E5FD  0D0A            mhelp           fcb     CR,LF
E5FF  436F6D6D616E6473206C697374                 fcc     "Commands list"
E60C  0D0A                            fcb     CR,LF
                      
E60E  2D2D2D2D2D2D2D2D2D2D2D2D2D                 fcc     "-------------"
E61B  0D0A                            fcb     CR,LF
                      
E61D  41736D20202020                  fcc     "Asm    "
E624  7B41616464727D                  fcc     "{Aaddr}"
E62B  0D0A                            fcb     CR,LF
                      
E62D  556E61736D2020                  fcc     "Unasm  "
E634  7B55206F72205561646472206F722055616464722C6C656E6774687D                 fcc     "{U or Uaddr or Uaddr,length}"
E650  0D0A                            fcb     CR,LF
                      
E652  44756D70202020                  fcc     "Dump   "
E659  7B44206F7220443C616464723E206F7220443C616464723E2C3C6C656E6774683E7D                 fcc     "{D or D<addr> or D<addr>,<length>}"
E67B  0D0A                            fcb     CR,LF
                      
E67D  456E7465722020                  fcc     "Enter  "
E684  7B45206F7220453C616464723E206F7220453C616464723E203C62797465733E206F7220453C616464723E737472696E677D                 fcc     "{E or E<addr> or E<addr> <bytes> or E<addr>string}"
E6B6  0D0A                            fcb     CR,LF
                      
E6B8  427265616B2020                  fcc     "Break  "
E6BF  7B42206F7220423C616464723E2E204220646973706C6179732C20423C616464723E2073657473206F7220636C6561727320627265616B706F696E747D                 fcc     "{B or B<addr>. B displays, B<addr> sets or clears breakpoint}"
E6FC  0D0A                            fcb     CR,LF
                      
E6FE  46696E64202020                  fcc     "Find   "
E705  7B4661646472206279746573206F72204661646472226173636969227D                 fcb     "{Faddr bytes or Faddr",34,"ascii",34,"}"
E722  0D0A                            fcb     CR,LF
                      
E724  476F2020202020                  fcc     "Go     "
E72B  7B47206F7220473C616464723E7D                 fcc     "{G or G<addr>}"
E739  0D0A                            fcb     CR,LF
                      
E73B  43616C63202020                  fcc     "Calc   "
E742  7B436865786E756D7B2B7C2D6865786E756D7D7D                 fcc     "{Chexnum{+|-hexnum}}"
E756  0D0A                            fcb     CR,LF
                      
E758  496E7020202020                  fcc     "Inp    "
E75F  7B49616464727D                  fcc     "{Iaddr}"
E766  0D0A                            fcb     CR,LF
                      
E768  4A756D70202020                  fcc     "Jump   "
E76F  7B4A3C616464723E7D                 fcc     "{J<addr>}"
E778  0D0A                            fcb     CR,LF
                      
E77A  4D6F7665202020                  fcc     "Move   "
E781  7B4D3C61646472313E2C3C61646472323E2C3C6C656E6768743E7D                 fcc     "{M<addr1>,<addr2>,<lenght>}"
E79C  0D0A                            fcb     CR,LF
                      
E79E  50726F67202020                  fcc     "Prog   "
E7A5  7B507D                          fcc     "{P}"
E7A8  0D0A                            fcb     CR,LF
                      
E7AA  52656773202020                  fcc     "Regs   "
E7B1  7B52206F7220523C6C65747465723E3C6865783E7D                 fcc     "{R or R<letter><hex>}"
E7C6  0D0A                            fcb     CR,LF
                      
E7C8  53726563202020                  fcc     "Srec   "
E7CF  7B534F3C616464723E206F722053533C616464723E2C3C6C656E3E206F722053313C62797465733E206F722053393C62797465733E7D                 fcc     "{SO<addr> or SS<addr>,<len> or S1<bytes> or S9<bytes>}"
E805  0D0A                            fcb     CR,LF
                      
E807  54726163652020                  fcc     "Trace  "
E80E  7B547D                          fcc     "{T}"
E811  0D0A                            fcb     CR,LF
                      
E813  586D6F64656D20                  fcc     "Xmodem "
E81A  7B5853616464722C6C656E20584C616464722C6C656E20585820584F63726C662C66696C6C65722C20585353616464722C6C656E7D                 fcc     "{XSaddr,len XLaddr,len XX XOcrlf,filler, XSSaddr,len}"
E84F  0D0A                            fcb     CR,LF
                      
E851  48656C70202020                  fcc     "Help   "
E858  7B487D                          fcc     "{H}"
E85B  0D0A00                          fcb     CR,LF,0
                      
                      
                      
                      * Here are some useful messages.
E85E  1C              welcome         fcb unknown-welcome-1
E85F  57656C636F6D6520746F2042554747592076657273696F6E20312E30                 fcc "Welcome to BUGGY version 1.0"
E87B  0F              unknown         fcb brkmsg-unknown-1
E87C  556E6B6E6F776E20636F6D6D616E64                 fcc "Unknown command"
E88B  0E              brkmsg          fcb clrmsg-brkmsg-1
E88C  427265616B706F696E7420736574                 fcc "Breakpoint set"
E89A  12              clrmsg          fcb fullmsg-clrmsg-1
E89B  427265616B706F696E7420636C6561726564                 fcc "Breakpoint cleared"
E8AD  10              fullmsg         fcb smsg-fullmsg-1
E8AE  427265616B706F696E74732066756C6C                 fcc "Breakpoints full"
E8BE  11              smsg            fcb lastrec-smsg-1
E8BF  4572726F7220696E2053207265636F7264                 fcc "Error in S record"
E8D0  0A              lastrec         fcb xsmsg-lastrec-1
E8D1  53393033303030304643                 fcc "S9030000FC"
E8DB  11              xsmsg           fcb xrmsg-xsmsg-1
E8DC  537461727420584D4F44454D2053656E64                 fcc "Start XMODEM Send"
E8ED  14              xrmsg           fcb xamsg-xrmsg-1
