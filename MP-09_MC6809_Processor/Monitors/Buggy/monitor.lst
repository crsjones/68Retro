E827  2715                            beq entdone
E829  A7A0                            sta ,y+
E82B  20F7                            bra entl2
E82D  10BE029D        entasc          ldy addr
E831  A680            entl3           lda ,x+
E833  4D                              tsta
E834  2708                            beq entdone
E836  8122                            cmpa #'"'
E838  2704                            beq entdone
E83A  A7A0                            sta ,y+
E83C  20F3                            bra entl3
E83E  10BF029D        entdone         sty addr
