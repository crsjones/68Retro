E911  BDE702                          jsr outd
E914  C620                            ldb #' '
E916  9D03                            jsr putchar
E918  39                              rts
                      
                      * Display the contents of the registers and disassemble instruction at
                      * PC location.
E919  C658            dispregs        ldb #'X'
E91B  10AE66                          ldy 6,s         ;Note that there's one return address on
E91E  8DE9                            bsr disp16      ;stack so saved register offsets are 
E920  C659                            ldb #'Y'        ;inremented by 2.
E922  10AE68                          ldy 8,s
E925  8DE2                            bsr disp16
E927  C655                            ldb #'U'
E929  10AE6A                          ldy 10,s
E92C  8DDB                            bsr disp16
E92E  C653                            ldb #'S'
E930  1F42                            tfr s,y
E932  312E                            leay 14,y       ;S of the running program is 12 higher,
                                                      ;because regs are not stacked when running.
E934  8DD3                            bsr disp16
E936  C641                            ldb #'A'
E938  A663                            lda 3,s
E93A  8DBF                            bsr disp8
E93C  C642                            ldb #'B'
E93E  A664                            lda 4,s
E940  8DB9                            bsr disp8
E942  C644                            ldb #'D'
E944  A665                            lda 5,s
E946  8DB3                            bsr disp8
E948  C643                            ldb #'C'
E94A  A662                            lda 2,s
E94C  8DAD                            bsr disp8
E94E  9D0C                            jsr putcr
E950  C650                            ldb #'P'
E952  10AE6C                          ldy 12,s
E955  8DB2                            bsr disp16
E957  BDF3CC                          jsr disdecode
E95A  BDF4AF                          jsr disdisp       ;Disassemble instruction at PC
E95D  9D0C                            jsr putcr
E95F  39                              rts
                      
                      
                      * This is the code for the R command, display or alter the registers.
                      * Syntax R or R<letter><hex>    
E960  8E0201          regs            ldx #linebuf+1
