                      * opcode offsets to basic opcode, depends on first nibble. 
F39F  000000000000A090 opcoffs         fcb 0,0,0,0,0,0,-$60,-$70
F3A7  00F0E0D000F0E0D0                 fcb 0,-$10,-$20,-$30,0,-$10,-$20,-$30
                      * mode depending on first nibble of opcode.
F3AF  03000000000005040103050401030504 modetab         fcb 3,0,0,0,0,0,5,4,1,3,5,4,1,3,5,4
                      * mode depending on category code stored in mnemtab
F3BF  00000105060707010202000809 modetab2        fcb 0,0,1,5,6,7,7,1,2,2,0,8,9
                      * modes in this context: 0 no operands, 1 8-bit immediate, 2 16 bit imm,
                      * 3, 8-bit address, 4 16 bit address, 5 indexed with postbyte, 6 short
                      * relative, 7 long relative, 8 pushpul, 9 tftetx
                      
                      * Decode instruction pointed to by Y for disassembly (and to find out
                      * how long it is). On return, U points to appropriate mnemonic table entry,
                      * Y points past instruction. 
                      * It's rather clumsy code, but we do want to reuse the same table
                      * as used with assembling.
F3CC  7F02BF          disdecode       clr prebyte
F3CF  7F02C3                          clr amode
F3D2  A6A0                            lda ,y+
F3D4  8110                            cmpa #$10
F3D6  2704                            beq ddec1
F3D8  8111                            cmpa #$11
F3DA  2605                            bne ddec2
F3DC  B702BF          ddec1           sta prebyte         ;Store $10 or $11 prebyte.
F3DF  A6A0                            lda ,y+             ;Get new opcode.
F3E1  B702C1          ddec2           sta opcode
F3E4  44                              lsra
F3E5  44                              lsra
F3E6  44                              lsra
F3E7  44                              lsra                ;Get high nibble.
F3E8  8EF3AF                          ldx #modetab
F3EB  E686                            ldb a,x
F3ED  F702C3                          stb amode
F3F0  8EF39F                          ldx #opcoffs
F3F3  A686                            lda a,x
F3F5  BB02C1                          adda opcode         ;Add opcode offset to opcode.               
F3F8  B702C0          ddec4           sta opc1            ;Store the 'basis' opcode.
F3FB  CEEEC4                          ldu #mnemtab
F3FE  8E0093                          ldx #mnemsize
F401  C60D            ddecloop        ldb #13
F403  E145                            cmpb 5,u            ;Compare category code with 13
F405  2708                            beq ddec3           ;13=pseudo op, no valid opcode
F407  FC02BF                          ldd prebyte
F40A  10A346                          cmpd 6,u
F40D  2722                            beq ddecfound       ;Opcode&prebyte agree, operation found.
F40F  3348            ddec3           leau 8,u            ;point to next mnemonic
F411  301F                            leax -1,x
F413  26EC                            bne ddecloop        
F415  CEF094                          ldu #mnemfcb        ;mnemonic not found, use FCB byte.
F418  8603                            lda #3
F41A  B702C3                          sta amode           ;Store mode 3, 8 bit address.
F41D  B602C1                          lda opcode
F420  7D02BF                          tst prebyte
F423  2708                            beq ddec5
F425  B602BF                          lda prebyte         ;if it was the combination prebyte
F428  7F02BF                          clr prebyte         ;and opcode that was not found,
F42B  313F                            leay -1,y           ;FCB just the prebyte
F42D  B702C5          ddec5           sta operand+1       ;The byte must be stored as operand.        
F430  39                              rts
F431  1183EFCC        ddecfound       cmpu #mnembsr
F435  260A                            bne ddec6
F437  868D                            lda #$8d            ;Is it really the BSR opcode?
F439  B102C1                          cmpa opcode
F43C  2703                            beq ddec6
F43E  CEF0CC                          ldu #mnemjsr        ;We mistakenly found BSR instead of JSR
F441  B602C3          ddec6           lda amode
F444  84FE                            anda #$FE
F446  260A                            bne ddec7
F448  A645                            lda 5,u             ;nibble-dependent mode was 0 or 1,
F44A  8EF3BF                          ldx #modetab2       ;use category dependent mode instead.
F44D  A686                            lda a,x
F44F  B702C3                          sta amode
F452  B602C3          ddec7           lda amode
F455  48                              asla
F456  8EF45B                          ldx #disdectab
F459  6E96                            jmp [a,x]           ;jump dependent on definitive mode.
F45B  F495F48FF496F48FF496F4A0 disdectab       fdb noop,opdec1,opdec2,opdec1,opdec2,opdecidx
F467  F48FF496F49AF49A                 fdb opdec1,opdec2,opdecpb,opdecpb
F46F  F495F495F495F495F495F495F495F495 disdectab1      fdb noop,noop,noop,noop,noop,noop,noop,noop
F47F  F48FF496F495F495F48FF496F495F496                 fdb opdec1,opdec2,noop,noop,opdec1,opdec2,noop,opdec2
F48F  E6A0            opdec1          ldb ,y+
F491  1D                              sex
F492  FD02C4          od1a            std operand
F495  39              noop            rts 
F496  ECA1            opdec2          ldd ,y++
F498  20F8                            bra od1a
F49A  E6A0            opdecpb         ldb ,y+
F49C  F702C2          odpa            stb postbyte
F49F  39                              rts
F4A0  E6A0            opdecidx        ldb ,y+
F4A2  2AF8                            bpl odpa        ;postbytes <$80 have no extra operands.
F4A4  F702C2                          stb postbyte    
F4A7  C40F                            andb #$0f
F4A9  58                              aslb
F4AA  8EF46F                          ldx #disdectab1
F4AD  6E95                            jmp [b,x]
                      
                      * Display disassembled instruction after the invocation of disdecode.
                      * U points to mnemonic table entry.
F4AF  1F31            disdisp         tfr u,x
F4B1  C605                            ldb #5
F4B3  9D09                            jsr putline      ;Display the mnemonic.
F4B5  C620                            ldb #' '
F4B7  9D03                            jsr putchar
F4B9  B602C3                          lda amode
F4BC  48                              asla
F4BD  8EF4C2                          ldx #disdisptab
F4C0  6E96                            jmp [a,x]        ;Perform action dependent on mode.
F4C2  F495F4D6F4DAF4E4F4DC disdisptab      fdb noop,disim8,disim16,disadr8,disadr16
F4CC  F59CF4ECF4FAF55AF511                 fdb disidx,disrel8,disrel16,distfr,dispush
F4D6  8D29            disim8          bsr puthash
F4D8  200A                            bra disadr8
F4DA  8D25            disim16         bsr puthash
F4DC  8D27            disadr16        bsr putdol
F4DE  FC02C4                          ldd operand
F4E1  7EE702                          jmp outd
F4E4  8D1F            disadr8         bsr putdol
F4E6  B602C5                          lda operand+1
F4E9  7EE6F4                          jmp outbyte
F4EC  8D17            disrel8         bsr putdol
F4EE  F602C5                          ldb operand+1
F4F1  1D                              sex
F4F2  109F24          dr8a            sty temp
F4F5  D324                            addd temp
F4F7  7EE702                          jmp outd
F4FA  8D09            disrel16        bsr putdol
F4FC  FC02C4                          ldd operand
F4FF  20F1                            bra dr8a
                                      
F501  C623            puthash         ldb #'#'
F503  0E03                            jmp putchar
F505  C624            putdol          ldb #'$'
F507  0E03                            jmp putchar                                                 
F509  C62C            putcomma        ldb #','
F50B  0E03                            jmp putchar
F50D  C620            putspace        ldb #' '
