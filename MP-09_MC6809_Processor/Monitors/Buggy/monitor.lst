                      * amode settings in assembler: 1=immediate, 2=direct/extended, 3=indexed
                      * etc. 4=pc relative, 5=indirect, 6=pcrelative and indirect.
                      
                      * This subroutine scans the assembler operands.
F94E  8DF6            scanops         bsr startop
F950  C15B                            cmpb #'['
F952  2607                            bne noindir
F954  8605                            lda #5          ;operand starts with [, then indirect.
F956  B702C3                          sta amode       
F959  E680                            ldb ,x+
F95B  C123            noindir         cmpb #'#'
F95D  10270087                        lbeq doimm
F961  C12C                            cmpb #','
F963  1027009A                        lbeq dospecial
F967  C4DF                            andb #CASEMASK    ;Convert to uppercase.
F969  8686                            lda #$86
