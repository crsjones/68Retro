E7E7  2703                            beq ent1
E7E9  FD029D                          std addr
E7EC  8D26            ent1            bsr entline
E7EE  1026FD8A                        lbne cmdline    ;No bytes, then enter interactively.            
E7F2  C645            ent2            ldb #'E'
E7F4  9D03                            jsr putchar
E7F6  FC029D                          ldd addr 
E7F9  BDE702                          jsr outd
E7FC  C620                            ldb #' '
E7FE  9D03                            jsr putchar     ;Display Eaddr + space
E800  8E0200                          ldx #linebuf
E803  C680                            ldb #buflen
