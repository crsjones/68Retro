EB85  1027FA4F                        lbeq unk
EB89  1F03                            tfr d,u
EB8B  BDE70B                          jsr skipspace
EB8E  C12C                            cmpb #','
EB90  1026FA44                        lbne unk
EB94  BDE733                          jsr scanhex
EB97  1027FA3D                        lbeq unk
EB9B  1F02                            tfr d,y         ;Read the argument separated by commas
EB9D  9E28                            ldx temp3       ;src addr to x, dest addr to u, length to y
                                                      ;Don't tolerate syntax deviations.
EB9F  A680            mvloop          lda ,x+
EBA1  A7C0                            sta ,u+
EBA3  313F                            leay -1,y
EBA5  26F8                            bne mvloop      ;Perform the block move.
EBA7  7EE57C                          jmp cmdline
                                      
                      
                      * This is the code for the F command, find byte/ascii string in memory.
                      * Syntax: Faddr bytes or Faddr "ascii"
EBAA  8E0201          find            ldx #linebuf+1
EBAD  BDE733                          jsr scanhex
EBB0  1F02                            tfr d,y         ;Scan the start address.
EBB2  BDE70B                          jsr skipspace
EBB5  C122                            cmpb #'"'
EBB7  2611                            bne findhex
EBB9  CE0200                          ldu #linebuf    ;Quote found, so scan for quoted string.
EBBC  4F                              clra
EBBD  E680            fstrloop        ldb ,x+
EBBF  271F                            beq startsrch   ;End of line without final quote.
EBC1  C122                            cmpb #'"'
EBC3  271B                            beq startsrch   ;End quote found
EBC5  E7C0                            stb ,u+
EBC7  4C                              inca
EBC8  20F3                            bra fstrloop                            
EBCA  CE0200          findhex         ldu #linebuf    ;Convert string of hex bytes.
EBCD  301F                            leax -1,x       ;String will be stored at start of line
EBCF  4F                              clra            ;buffer and may overwrite part of the
EBD0  3402            fhexloop        pshs a          ;already converted string.
EBD2  BDE76E                          jsr scanbyte
EBD5  1F89                            tfr a,b
EBD7  3502                            puls a
EBD9  2705                            beq startsrch   
EBDB  E7C0                            stb ,u+
EBDD  4C                              inca
EBDE  20F0                            bra fhexloop                            
EBE0  4D              startsrch       tsta            ;Start searching, start addr in Y, 
                                                      ;string starts at linebuf, length A
EBE1  1027F997                        lbeq cmdline    ;Quit with zero length string.
EBE5  0F28                            clr temp3
EBE7  9729                            sta temp3+1
EBE9  1F21            srchloop        tfr y,x
EBEB  9629                            lda temp3+1
EBED  8CE100                          cmpx #$e100
EBF0  2409                            bcc srch1
EBF2  3086                            leax a,x
EBF4  8CE000                          cmpx #$e000     ;Stop at I/O addresses.
EBF7  1024F981                        lbcc cmdline
EBFB  1F21            srch1           tfr y,x
EBFD  CE0200                          ldu #linebuf
EC00  E680            srch2           ldb ,x+
EC02  E1C0                            cmpb ,u+
EC04  2614                            bne srch3       ;Not equal, try next address.
EC06  4A                              deca 
EC07  26F7                            bne srch2
EC09  1F20                            tfr y,d
EC0B  BDE702                          jsr outd        ;String found
EC0E  9D0C                            jsr putcr
EC10  0C28                            inc temp3
EC12  9628                            lda temp3
EC14  8110                            cmpa #$10
EC16  1027F962                        lbeq cmdline    ;If 10 matches found, just stop.
EC1A  3121            srch3           leay 1,y
EC1C  20CB                            bra srchloop
                      
                      * Send the contents of the xmodem buffer and get it acknowledged, zero flag
                      * is set if transfer aborted.
EC1E  C601            xsendbuf        ldb #SOH                
EC20  BDE474                          jsr osputc      ;Send SOH
EC23  D62D                            ldb xpacknum
EC25  BDE474                          jsr osputc      ;Send block number.
EC28  53                              comb
EC29  BDE474                          jsr osputc      ;and its complement.
EC2C  0F2E                            clr xsum
EC2E  8680                            lda #128
EC30  8E0100                          ldx #buf0
EC33  E684            xsloop          ldb ,x
EC35  DB2E                            addb xsum
EC37  D72E                            stb xsum        
EC39  E680                            ldb ,x+
EC3B  BDE474                          jsr osputc
EC3E  4A                              deca
EC3F  26F2                            bne xsloop      ;Send the buffer contents.
EC41  D62E                            ldb xsum
EC43  BDE474                          jsr osputc      ;Send the check sum
EC46  BDE45D          waitack         jsr osgetc
EC49  C118                            cmpb #CAN
EC4B  270C                            beq xsabt       ;^X for abort.
EC4D  C115                            cmpb #NAK        
EC4F  27CD                            beq xsendbuf    ;Send again if NAK
EC51  C106                            cmpb #ACK
EC53  26F1                            bne waitack
EC55  0C2D                            inc xpacknum
EC57  1CFB            xsok            andcc #$fb      ;Clear zero flag after ACK              
EC59  39              xsabt           rts
                                      
                      * Start an XMODEM send session.
EC5A  C601            xsendinit       ldb #1
EC5C  D72D                            stb xpacknum    ;Initialize block number.
EC5E  BDE45D          waitnak         jsr osgetc
EC61  C118                            cmpb #CAN
EC63  27F4                            beq xsabt      ;If ^X exit with zero flag.
EC65  C115                            cmpb #NAK
EC67  27EE                            beq xsok        
EC69  20F3                            bra waitnak    ;Wait until NAK received.
                      
                      * Send ETX and wait for ack.
EC6B  C604            xsendeot        ldb #EOT
EC6D  BDE474                          jsr osputc
EC70  BDE45D          waitack2        jsr osgetc
EC73  C118                            cmpb #CAN
EC75  27E2                            beq xsabt
EC77  C115                            cmpb #NAK
EC79  27F0                            beq xsendeot
EC7B  C106                            cmpb #ACK
EC7D  27D8                            beq xsok
EC7F  20EF                            bra waitack2
                      
                      * Read character into B with a timeout of A seconds,  Carry set if timeout.
EC81  48              gettimeout      asla
EC82  C632                            ldb #50
EC84  3D                              mul
EC85  1F98                            tfr b,a
EC87  9B2C                            adda timer+2
EC89  BDE468          gt1             jsr osgetpoll
EC8C  5D                              tstb
EC8D  2607                            bne gtexit
EC8F  912C                            cmpa timer+2
EC91  26F6                            bne gt1         
EC93  1A01                            orcc #$1
EC95  39                              rts
EC96  BDE45D          gtexit          jsr osgetc
EC99  1CFE                            andcc #$fe
EC9B  39                              rts
                      
                      * Wait until line becomes quiet.
EC9C  8603            purge           lda #3
EC9E  BDEC81                          jsr gettimeout
ECA1  24F9                            bcc purge
ECA3  39                              rts
                      
                      * Receive an XMODEM block and wait till it is OK, Z set if etx.                         
ECA4  8603            xrcvbuf         lda #3
ECA6  0D2F                            tst lastok                              
ECA8  2709                            beq sendnak
ECAA  C606                            ldb #ACK
ECAC  BDE474                          jsr osputc      ;Send an ack.
ECAF  8605                            lda #5         
ECB1  2005                            bra startblock
ECB3  C615            sendnak         ldb #NAK
ECB5  BDE474                          jsr osputc      ;Send a NAK
ECB8  0F2F            startblock      clr lastok
ECBA  8DC5                            bsr gettimeout   
ECBC  8603                            lda #3
ECBE  25F3                            bcs sendnak     ;Keep sending NAKs when timed out.
ECC0  C104                            cmpb #EOT               
ECC2  2752                            beq xrcveot     ;End of file reached, acknowledge EOT.
ECC4  C101                            cmpb #SOH
ECC6  2649                            bne purgeit     ;Not, SOH, bad block.
ECC8  8601                            lda #1
ECCA  8DB5                            bsr gettimeout  
ECCC  2543                            bcs purgeit                             
ECCE  D12D                            cmpb xpacknum   ;Is it the right block?
ECD0  2707                            beq xr1
ECD2  5C                              incb
ECD3  D12D                            cmpb xpacknum   ;Was it the previous block.
ECD5  263A                            bne purgeit     
ECD7  0C2F                            inc lastok
ECD9  D72E            xr1             stb xsum
ECDB  8601                            lda #1
ECDD  8DA2                            bsr gettimeout
ECDF  2530                            bcs purgeit
ECE1  53                              comb
ECE2  D12E                            cmpb xsum       ;Is the complement of the block number OK
ECE4  262B                            bne purgeit             
ECE6  8E0100                          ldx #buf0
ECE9  0F2E                            clr xsum
ECEB  8601            xrloop          lda #1
ECED  8D92                            bsr gettimeout  
ECEF  2520                            bcs purgeit
ECF1  E780                            stb ,x+
ECF3  DB2E                            addb xsum
ECF5  D72E                            stb xsum
ECF7  8C0180                          cmpx #buf0+128
ECFA  26EF                            bne xrloop       ;Get the data bytes.           
ECFC  8601                            lda #1
ECFE  8D81                            bsr gettimeout
ED00  250F                            bcs purgeit
ED02  D12E                            cmpb xsum
ED04  260B                            bne purgeit     ;Check the check sum.
ED06  0D2F                            tst lastok
ED08  269A                            bne xrcvbuf     ;Block was the previous block, get next one
ED0A  0C2F                            inc lastok
ED0C  0C2D                            inc xpacknum
ED0E  1CFB                            andcc #$fb
ED10  39                              rts
ED11  BDEC9C          purgeit         jsr purge
ED14  209D                            bra sendnak             
ED16  8603            xrcveot         lda #3          ;EOT was received.
ED18  C606                            ldb #ACK
ED1A  BDE474          ackloop         jsr osputc
ED1D  4A                              deca
ED1E  26FA                            bne ackloop     ;Send 3 acks in a row.
ED20  39                              rts
                      
                      
ED21  9E01            savevecs        ldx getchar+1
ED23  BF02B4                          stx oldgetc
ED26  9E04                            ldx putchar+1
ED28  BF02B6                          stx oldputc
ED2B  9E0D                            ldx putcr+1
ED2D  BF02B8                          stx oldputcr
ED30  7F02BA                          clr lastterm
ED33  39                              rts
                      
ED34  BE02B4          rstvecs         ldx oldgetc
ED37  9F01                            stx getchar+1
ED39  BE02B6                          ldx oldputc
ED3C  9F04                            stx putchar+1
ED3E  BE02B8                          ldx oldputcr
ED41  9F0D                            stx putcr+1
ED43  7F02BA                          clr lastterm
ED46  39                              rts     
                      
                      * O.S. routine to open input through XMODEM transfer.
ED47  3416            xopin           pshs x,a,b
ED49  8EE662                          ldx #xsmsg
ED4C  BDE505                          jsr outcount
ED4F  9D0C                            jsr putcr       ;Display message to start XMODEM send.
ED51  8DCE                            bsr savevecs
ED53  8EF495                          ldx #noop
ED56  9F04                            stx putchar+1   ;Disable character output.
ED58  8EEE15                          ldx #xgetc
ED5B  9F01                            stx getchar+1   ;
ED5D  0F2F                            clr lastok
ED5F  0F30                            clr xcount
ED61  8601                            lda #1
ED63  972D                            sta xpacknum
ED65  4C                              inca
ED66  9731                            sta xmode       ;set xmode to 2.
ED68  3596                            puls x,a,b,pc
                      
                      * O.S. routine to open output through XMODEM transfer.
ED6A  3416            xopout          pshs x,a,b
ED6C  8DB3                            bsr savevecs
ED6E  8EE674                          ldx #xrmsg
ED71  BDE505                          jsr outcount    ;Display message to start XMODEM receive
ED74  9D0C                            jsr putcr
ED76  8EEDDC                          ldx #xputc
ED79  9F04                            stx putchar+1
ED7B  8EEDFA                          ldx #xputcr
ED7E  9F0D                            stx putcr+1
ED80  BDEC5A                          jsr xsendinit
ED83  102700B7                        lbeq xerror
ED87  0F30                            clr xcount
ED89  8601                            lda #1
ED8B  9731                            sta xmode
ED8D  3596                            puls x,a,b,pc
                                      
                      
                      * O.S. routine to abort input through XMODEM transfer.
ED8F  9631            xabtin          lda xmode
ED91  8102                            cmpa #2
ED93  263C                            bne xclsend
ED95  BDEC9C                          jsr purge
ED98  C618                            ldb #CAN
ED9A  8608                            lda #8
ED9C  BDE474          xabtloop        jsr osputc
ED9F  4A                              deca
EDA0  26FA                            bne xabtloop    ;Send 8 CAN characters to kill transfer.
EDA2  8D90                            bsr rstvecs
EDA4  0F31                            clr xmode
EDA6  8EE689                          ldx #xamsg
EDA9  BDE505                          jsr outcount
EDAC  9D0C                            jsr putcr       ;Send diagnostic message.
EDAE  39                              rts             
                      
                      * O.S. routine to close output through XMODEM transfer.
EDAF  9631            xclsout         lda xmode 
EDB1  8101                            cmpa #1
EDB3  261C                            bne xclsend
EDB5  0D30                            tst xcount
EDB7  270C                            beq xclsdone
EDB9  8680                            lda #128
EDBB  9030                            suba xcount
EDBD  F602BB          xclsloop        ldb filler
EDC0  8D1A                            bsr xputc   
EDC2  4A                              deca
EDC3  26F8                            bne xclsloop    ;Transfer filler chars to force block out.
EDC5  BDEC6B          xclsdone        jsr xsendeot    ;Send EOT
EDC8  10270072                        lbeq xerror
EDCC  BDED34                          jsr rstvecs
EDCF  0F31                            clr xmode                                               
EDD1  39              xclsend         rts     
                      
                      * O.S. routine to close input through XMODEM, by gobbling up the remaining
                      * bytes.
EDD2  D631            xclsin          ldb xmode
EDD4  C102                            cmpb #2
EDD6  26F9                            bne xclsend
EDD8  9D03                            jsr putchar
EDDA  20F6                            bra xclsin
                      
                      * putchar routine for XMODEM 
EDDC  3416            xputc           pshs x,a,b
EDDE  9630                            lda xcount
EDE0  0C30                            inc xcount
EDE2  8E0100                          ldx #buf0
EDE5  E786                            stb a,x         ;Store character in XMODEM buffer.
EDE7  817F                            cmpa #127
EDE9  260D                            bne xputc1      ;is buffer full?
EDEB  0F30                            clr xcount
EDED  3460                            pshs y,u
EDEF  BDEC1E                          jsr xsendbuf    
EDF2  10270048                        lbeq xerror
EDF6  3560                            puls y,u
EDF8  3596            xputc1          puls x,a,b,pc                   
                      
                      * putcr routine for XMODEM
EDFA  3404            xputcr          pshs b
EDFC  F602BC                          ldb xmcr
EDFF  C502                            bitb #2
EE01  2704                            beq xputcr1
EE03  C60D                            ldb #CR
EE05  8DD5                            bsr xputc
EE07  F602BC          xputcr1         ldb xmcr
EE0A  C501                            bitb #1
EE0C  2704                            beq xputcr2
EE0E  C60A                            ldb #LF
EE10  8DCA                            bsr xputc               
EE12  3504            xputcr2         puls b
EE14  39                              rts
                      
                      * getchar routine for XMODEM
EE15  3412            xgetc           pshs x,a
EE17  0D30                            tst xcount      ;No characters left?
EE19  260D                            bne xgetc1
EE1B  3460                            pshs y,u
EE1D  BDECA4                          jsr xrcvbuf     ;Receive new block.
EE20  3560                            puls y,u
EE22  2710                            beq xgetcterm   ;End of input?          
EE24  8680                            lda #128
EE26  9730                            sta xcount
EE28  9630            xgetc1          lda xcount
EE2A  40                              nega
EE2B  8E0180                          ldx #buf0+128
EE2E  E686                            ldb a,x         ;Get character from buffer
EE30  0A30                            dec xcount
EE32  3592                            puls x,a,pc             
EE34  BDED34          xgetcterm       jsr rstvecs
EE37  0F31                            clr xmode
EE39  F602BB                          ldb filler
EE3C  3592                            puls x,a,pc
                                      
EE3E  BDED34          xerror          jsr rstvecs     ;Restore I/O vectors
EE41  0F31                            clr xmode
EE43  8EE689                          ldx #xamsg
EE46  BDE505                          jsr outcount
EE49  9D0C                            jsr putcr
EE4B  7E0292                          jmp xerrvec
                              
EE4E  10FE02BD        xerrhand        lds savesp
EE52  7EE57C                          jmp cmdline
                      
                      * This is the code for the X command, various XMODEM related commands.
                      * Syntax: XSaddr,len XLaddr,len XX XOcrlf,filler, XSSaddr,len
EE55  8E0201          xmodem          ldx #linebuf+1
