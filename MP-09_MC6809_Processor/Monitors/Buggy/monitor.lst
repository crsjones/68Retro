                      ;Buggy machine language monitor and rudimentary O.S. version 1.0
                      ;monitor.asm
                      * Memory map of SBC
                      * $0-$40 Zero page variables reserved by monitor and O.S.
                      * $40-$FF Zero page portion for user programs.
                      * $100-$17F Xmodem buffer 0, terminal input buffer,
                      * $180-$1FF Xmodem buffer 1, terminal output buffer.
                      * $200-$27F Terminal input line.
                      * $280-$2FF Variables reserved by monitor and O.S.
                      * $300-$400 System stack.
                      * $400-$7FFF RAM for user programs and data.
                      * $8000-$DFFF PROM for user programs.
                      * $E000-$E1FF I/O addresses.
                      * $E200-$E3FF Reserved.
                      * $E400-$FFFF Monitor ROM
                      
                      * Reserved Zero page addresses
0000                                  org $0000
0000                                  setdp 0
                      * First the I/O routine vectors.
0000                  getchar         rmb 3           ;Jump to getchar routine.
0003                  putchar         rmb 3           ;Jump to putchar routine.
0006                  getline         rmb 3           ;Jump to getline routine.
0009                  putline         rmb 3           ;Jump to putline routine.
000C                  putcr           rmb 3           ;Jump to putcr routine.
000F                  getpoll         rmb 3           ;Jump to getpoll routine.
0012                  xopenin         rmb 3           ;Jump to xopenin routine.
0015                  xopenout        rmb 3           ;Jump to xopenout routine.
0018                  xabortin        rmb 3           ;Jump to xabortin routine.
001B                  xclosein        rmb 3           ;Jump to xclosein routine.
001E                  xcloseout       rmb 3           ;Jump to xcloseout routine.
0021                  delay           rmb 3           ;Jump to delay routine.
                      
                      *Next the system variables in the zero page.
0024                  temp            rmb 2            ;hex scanning/disasm
0026                  temp2           rmb 2            ;Hex scanning/disasm
0028                  temp3           rmb 2            ;Used in Srecords, H command
002A                  timer           rmb 3            ;3 byte timer, incremented every 20ms
002D                  xpacknum        rmb 1            ;Packet number for XMODEM block,
002E                  xsum            rmb 1            ;XMODEM checksum
002F                  lastok          rmb 1            ;flag to indicate last block was OK
0030                  xcount          rmb 1            ;Count of characters in buffer.
0031                  xmode           rmb 1            ;XMODEM mode, 0 none, 1 out, 2 in.
                      
                      * I/O buffers.
0080                  buflen          equ 128         ;Length of input line buffer.
0100                                  org $100
0100                  buf0            rmb 128         ;Xmodem buffer 0, serial input buffer.
0180                  buf1            rmb 128         ;Xmodem buffer 1, serial output buffer.
0200                  linebuf         rmb buflen      ;Input line buffer.
                      
                      
                      * Interrupt vectors (start at $280)
                      * All interrupts except RESET are vectored through jumps.
                      * FIRQ is timer interrupt, IRQ is ACIA interrupt.
0280                  swi3vec         rmb 3
0283                  swi2vec         rmb 3
0286                  firqvec         rmb 3
0289                  irqvec          rmb 3
028C                  swivec          rmb 3
028F                  nmivec          rmb 3
0292                  xerrvec         rmb 3           ;Error handler for XMODEM error.
0295                  exprvec         rmb 3           ;Expression evaluator in assembler.
0298                  asmerrvec       rmb 3           ;Error handler for assembler errors.
                      
                      * Next the non zero page system variables.
029B                  oldpc           rmb 2           ;Saved pc value for J command.
029D                  addr            rmb 2           ;Address parameter.
029F                  length          rmb 2           ;Length parameter.
                      
0004                  brkpoints       equ 4           ;Number of settable breakpoints. 
02A1                  bpaddr          rmb brkpoints*3 ;Address and byte for each break point.
02AD                  stepbp          rmb 3           ;Address of P command break point.
                      
02B0                  sorg            rmb 2           ;Origin address of S record entry.
02B2                  soffs           rmb 2           ;Offset load adrr-addr in record
                      
02B4                  oldgetc         rmb 2           ;Old getchar address.
02B6                  oldputc         rmb 2           ;Old putchar address.
02B8                  oldputcr        rmb 2           ;Old putcr address.
02BA                  lastterm        rmb 1           ;Last terminating character.
02BB                  filler          rmb 1           ;Filler at end of XMODEM file.
02BC                  xmcr            rmb 1           ;end-of-line characters for XMODEM send.
02BD                  savesp          rmb 2           ;Save sp to restore it on error.
                      
                      * Following variables are used by assembler/disassembler.
02BF                  prebyte         rmb 1
02C0                  opc1            rmb 1
02C1                  opcode          rmb 1
02C2                  postbyte        rmb 1
02C3                  amode           rmb 1
02C4                  operand         rmb 2           
02C6                  mnembuf         rmb 5           ;Buffer to store capitalized mnemonic.
02CB                  opsize          rmb 1           ;SIze (in bytes) of extra oeprand (0--2)
02CC                  uncert          rmb 1           ;Flag to indicate that op is unknown.
02CD                  dpsetting       rmb 2
                      
02CF                  endvars         equ *
                      
0400                  ramstart        equ $400        ;first free RAM address.
                      
8000                  ramtop          equ $8000       ;top of RAM.
                      
                      * I/O port addresses
E000                  aciactl         equ $e000       ;Control port of ACIA
E000                  aciasta         equ $e000       ;Status port of ACIA
E001                  aciadat         equ $e001       ;Data port of ACIA
                      
                      * ASCII control characters.
0001                  SOH             equ 1
0004                  EOT             equ 4
0006                  ACK             equ 6
0008                  BS              equ 8
0009                  TAB             equ 9
000A                  LF              equ 10
000D                  CR              equ 13
0015                  NAK             equ 21
0018                  CAN             equ 24
007F                  DEL             equ 127
                      
00DF                  CASEMASK        equ $DF         ;Mask to make lowercase into uppercase.
                      
                      * Monitor ROM starts here.
E400                                  org $E400
                      
E400  1AFF            reset           orcc #$FF       ;Disable interrupts.
E402  4F                              clra            
E403  1F8B                            tfr a,dp        ;Set direct page register to 0.
E405  10CE0400                        lds #ramstart
E409  8EE523                          ldx #intvectbl
E40C  CE0280                          ldu #swi3vec
E40F  C61B                            ldb #osvectbl-intvectbl
E411  8D37                            bsr blockmove   ;Initialize interrupt vectors from ROM.
E413  8EE53E                          ldx #osvectbl
E416  CE0000                          ldu #0
E419  C624                            ldb #endvecs-osvectbl
E41B  8D2D                            bsr blockmove   ;Initialize I/O vectors from ROM.
E41D  8D33                            bsr initacia    ;Initialize serial port.
E41F  1C00                            andcc #$0       ;Enable interrupts
                      * Put the 'saved' registers of the program being monitored on top of the
                      * stack. There are 12 bytes on the stack for cc,b,a,dp,x,y,u and pc
                      * pc is initialized to $400, the rest to zero.
E421  8E0000                          ldx #0          
E424  1F12                            tfr x,y
E426  CE0400                          ldu #ramstart
E429  3450                            pshs x,u
E42B  3430                            pshs x,y
E42D  3430                            pshs x,y  
E42F  8E029B                          ldx #oldpc
E432  C634                            ldb #endvars-oldpc
E434  6F80            clvar           clr ,x+
E436  5A                              decb
E437  26FB                            bne clvar       ;Clear the variable area.
E439  CC1A03                          ldd #$1A03      
E43C  FD02BB                          std filler      ;Set XMODEM filler and end-of-line.
E43F  8EE5E5                          ldx #welcome
E442  BDE505                          jsr outcount
E445  9D0C                            jsr putcr       ;Print a welcome message.      
E447  7EE57C                          jmp cmdline
                      * Block move routine, from X to U length B. Modifies them all and A. 
E44A  A680            blockmove       lda ,x+
E44C  A7C0                            sta ,u+
E44E  5A                              decb
E44F  26F9                            bne blockmove
E451  39                              rts
                      
                      * Initialize serial communications port, buffers, interrupts.
E452  C603            initacia        ldb #$03     ;reset ACIA
E454  F7E000                          stb aciactl
E457  C615                            ldb #%00010101   ;tx interrupts disabled
E459  F7E000                          stb aciactl      ;set ACIA control register
E45C  39                              rts
                      
                      * O.S. routine to read a character into B register.
E45D  F6E000          osgetc          ldb aciasta
E460  C501                            bitb #$01
E462  27F9                            beq osgetc
E464  F6E001                          ldb aciadat
E467  39                              rts
                      
                      ;O.S. rotuine to check if there is a character ready to be read.
E468  F6E000          osgetpoll       ldb aciasta
E46B  C501                            bitb #$01
E46D  2602                            bne poltrue
E46F  5F                              clrb
E470  39                              rts
E471  C6FF            poltrue         ldb #$ff
E473  39                              rts
                      
                      * O.S. routine to write the character in the B register.
E474  3402            osputc          pshs a
E476  B6E000          putcloop        lda aciasta
E479  8502                            bita #$02
E47B  27F9                            beq putcloop
E47D  F7E001                          stb aciadat
E480  3502                            puls a
E482  39                              rts
                      
                      * O.S. routine to read a line into memory at address X, at most B chars
                      * long, return actual length in B. Permit backspace editing.
E483  3412            osgetl          pshs a,x
E485  D724                            stb temp
E487  4F                              clra
E488  9D00            osgetl1         jsr getchar
E48A  C47F                            andb #$7F               
E48C  C108                            cmpb #BS
E48E  2704                            beq backsp
E490  C17F                            cmpb #DEL
E492  2614                            bne osgetl2       
E494  4D              backsp          tsta                  ;Recognize BS and DEL as backspace key.
E495  27F1                            beq osgetl1           ;ignore if line already zero length.
E497  C608                            ldb #BS
E499  9D03                            jsr putchar
E49B  C620                            ldb #' '
E49D  9D03                            jsr putchar
E49F  C608                            ldb #BS               ;Send BS,space,BS. This erases last
E4A1  9D03                            jsr putchar           ;character on most terminals.
E4A3  301F                            leax -1,x             ;Decrement address.
E4A5  4A                              deca
E4A6  20E0                            bra osgetl1
E4A8  C10D            osgetl2         cmpb #CR
E4AA  270D                            beq newline
E4AC  C10A                            cmpb #LF
E4AE  2613                            bne osgetl3           ;CR or LF character ends line.
E4B0  F602BA                          ldb lastterm
E4B3  C10D                            cmpb #CR
E4B5  27D1                            beq osgetl1           ;Ignore LF if it comes after CR
E4B7  C60A                            ldb #LF               
E4B9  F702BA          newline         stb lastterm
E4BC  9D0C                            jsr putcr             
E4BE  1F89                            tfr a,b               ;Move length to B
E4C0  3512                            puls a,x              ;restore registers.
E4C2  39                              rts                   ;<--- Here is the exit point.
E4C3  C109            osgetl3         cmpb #TAB
E4C5  270F                            beq dotab               
E4C7  C120                            cmpb #' '
E4C9  25BD                            blo osgetl1           ;Ignore control characters.
E4CB  9124                            cmpa temp
E4CD  27B9                            beq osgetl1           ;Ignore char if line full.
E4CF  9D03                            jsr putchar           ;Echo the character.
E4D1  E780                            stb ,x+               ;Store it in memory.
E4D3  4C                              inca
E4D4  20B2                            bra osgetl1
E4D6  C620            dotab           ldb #' '
E4D8  9124                            cmpa temp
E4DA  27AC                            beq osgetl1
E4DC  9D03                            jsr putchar
E4DE  E780                            stb ,x+
E4E0  4C                              inca
E4E1  8507                            bita #7                ;Insert spaces until length mod 8=0
E4E3  26F1                            bne dotab
E4E5  20A1                            bra osgetl1 
                      
                      * O.S. routine to write a line starting at address X, B chars long.
E4E7  3416            osputl          pshs a,b,x
E4E9  1F98                            tfr b,a
E4EB  4D                              tsta
E4EC  2707                            beq osputl1
E4EE  E680            osputl2         ldb ,x+
E4F0  9D03                            jsr putchar
E4F2  4A                              deca
E4F3  26F9                            bne osputl2
E4F5  3516            osputl1         puls a,b,x
E4F7  39                              rts
                      
                      * O.S. routine to terminate a line.
E4F8  3404            oscr            pshs b
E4FA  C60D                            ldb #CR
E4FC  9D03                            jsr putchar
E4FE  C60A                            ldb #LF
E500  9D03                            jsr putchar     ;Send the CR and LF characters.
E502  3504                            puls b
E504  39                              rts
                      
                      * Output a counted string at addr X
E505  3414            outcount        pshs x,b
E507  E680                            ldb ,x+
E509  9D09                            jsr putline
E50B  3514                            puls x,b
E50D  39                              rts
                      
E50E  0C2C            timerirq        inc timer+2
E510  2608                            bne endirq
E512  0C2B                            inc timer+1
E514  2604                            bne endirq
E516  0C2A                            inc timer
E518  3B                              rti
E519  12              aciairq         nop
E51A  3B              endirq          rti
                      
                      * Wait D times 20ms.
E51B  D32B            osdly           addd timer+1
E51D  10932B          dlyloop         cmpd timer+1
E520  26FB                            bne dlyloop
E522  39                              rts             
                      
                      * This table will be copied to the interrupt vector area in RAM.
E523  7EE51A          intvectbl       jmp endirq
E526  7EE51A                          jmp endirq
E529  7EE50E                          jmp timerirq
E52C  7EE519                          jmp aciairq
E52F  7EE56D                          jmp unlaunch
E532  7EE51A                          jmp endirq
E535  7EEE4E                          jmp xerrhand
E538  7EF6FC                          jmp expr
E53B  7E0298                          jmp asmerrvec
                      * And this one to the I/O vector table.
E53E  7EE45D          osvectbl        jmp osgetc
E541  7EE474                          jmp osputc
E544  7EE483                          jmp osgetl
E547  7EE4E7                          jmp osputl
E54A  7EE4F8                          jmp oscr                
E54D  7EE468                          jmp osgetpoll
E550  7EED47                          jmp xopin
E553  7EED6A                          jmp xopout
E556  7EED8F                          jmp xabtin
E559  7EEDD2                          jmp xclsin
E55C  7EEDAF                          jmp xclsout
E55F  7EE51B                          jmp osdly
E562                  endvecs         equ *           
                                      
                      * The J command returns here.
E562  3410            stakregs        pshs x               ;Stack something where the pc comes
E564  347F                            pshs cc,b,a,dp,x,y,u ;Stack the normal registers.
E566  BE029B                          ldx oldpc       
E569  AF6A                            stx 10,s             ;Stack the old pc value.
E56B  2007                            bra unlaunch1
                      * The G and P commands return here through a breakpoint.
                      * Registers are already stacked.
E56D  EC6A            unlaunch        ldd 10,s
E56F  830001                          subd #1
E572  ED6A                            std 10,s             ;Decrement pc before breakpoint
E574  1C00            unlaunch1       andcc #$0            ;reenable the interrupts.
E576  BDE9C4                          jsr disarm           ;Disarm the breakpoints.
E579  BDE919                          jsr dispregs         
E57C  9D1E            cmdline         jsr xcloseout
E57E  10FF02BD                        sts savesp
E582  8E0200                          ldx #linebuf
E585  C680                            ldb #buflen
E587  9D06                            jsr getline
E589  5D                              tstb
E58A  27F0                            beq cmdline          ;Ignore line if it is empty
E58C  3A                              abx
E58D  6F84                            clr ,x               ;Make location after line zero.
E58F  8E0200                          ldx #linebuf
E592  E680                            ldb ,x+
E594  C4DF                            andb #CASEMASK       ;Make 1st char uppercase.
E596  C041                            subb #'A'            
E598  253E                            bcs unk
E59A  C11A                            cmpb #26
E59C  243A                            bcc unk              ;Unknown cmd if it is not a letter.
E59E  8EE5A4                          ldx #cmdtab
E5A1  58                              aslb                  ;Index into command table.
E5A2  6E95                            jmp [b,x]
                      
E5A4  FC05E9FAE5D8E787 cmdtab          fdb asm,break,unk,dump
E5AC  E7E1EBAAE88EE85A                 fdb enter,find,go,hex
E5B4  E848E89DE5D8E5D8                 fdb inp,jump,unk,unk
E5BC  EB6DE5D8E5D8E8BC                 fdb move,unk,unk,prog
E5C4  E5D8E960EA68E8C8                 fdb unk,regs,srec,trace
E5CC  F6A5E5D8E5D8EE55                 fdb unasm,unk,unk,xmodem
E5D4  E5D8E5D8                        fdb unk,unk
                      
                      * Unknown command handling routine.
E5D8  9D18            unk             jsr xabortin
E5DA  8EE602                          ldx #unknown
E5DD  BDE505                          jsr outcount
E5E0  9D0C                            jsr putcr
E5E2  7EE57C                          jmp cmdline
                      
                      
                      
                      * Here are some useful messages.
E5E5  1C              welcome         fcb unknown-welcome-1
E5E6  57656C636F6D6520746F2042554747592076657273696F6E20312E30                 fcc "Welcome to BUGGY version 1.0"
E602  0F              unknown         fcb brkmsg-unknown-1
E603  556E6B6E6F776E20636F6D6D616E64                 fcc "Unknown command"
E612  0E              brkmsg          fcb clrmsg-brkmsg-1
E613  427265616B706F696E7420736574                 fcc "Breakpoint set"
E621  12              clrmsg          fcb fullmsg-clrmsg-1
E622  427265616B706F696E7420636C6561726564                 fcc "Breakpoint cleared"
E634  10              fullmsg         fcb smsg-fullmsg-1
E635  427265616B706F696E74732066756C6C                 fcc "Breakpoints full"
E645  11              smsg            fcb lastrec-smsg-1
E646  4572726F7220696E2053207265636F7264                 fcc "Error in S record"
E657  0A              lastrec         fcb xsmsg-lastrec-1
E658  53393033303030304643                 fcc "S9030000FC"
E662  11              xsmsg           fcb xrmsg-xsmsg-1
E663  537461727420584D4F44454D2053656E64                 fcc "Start XMODEM Send"
E674  14              xrmsg           fcb xamsg-xrmsg-1
E675  537461727420584D4F44454D2052656365697665                 fcc "Start XMODEM Receive"
E689  17              xamsg           fcb invmmsg-xamsg-1
E68A  584D4F44454D207472616E736665722061626F72746564                 fcc "XMODEM transfer aborted"
E6A1  10              invmmsg         fcb exprmsg-invmmsg-1
E6A2  496E76616C6964206D6E656D6F6E6963                 fcc "Invalid mnemonic"
E6B2  10              exprmsg         fcb modemsg-exprmsg-1
E6B3  45787072657373696F6E206572726F72                 fcc "Expression error"
E6C3  15              modemsg         fcb brmsg-modemsg-1
E6C4  41646472657373696E67206D6F6465206572726F72                 fcc "Addressing mode error"             
E6D9  0F              brmsg           fcb endmsg-brmsg-1
E6DA  4272616E636820746F6F206C6F6E67                 fcc "Branch too long"
E6E9                  endmsg          equ *
                      
                      * Output hex digit contained in A
E6E9  8B90            hexdigit        adda #$90
E6EB  19                              daa
E6EC  8940                            adca #$40
E6EE  19                              daa             ;It's the standard conversion trick ascii
E6EF  1F89                            tfr a,b         ;to hex without branching.
E6F1  9D03                            jsr putchar
E6F3  39                              rts
                      
                      * Output contents of A as two hex digits 
E6F4  3402            outbyte         pshs a          
E6F6  44                              lsra
E6F7  44                              lsra
E6F8  44                              lsra
E6F9  44                              lsra
E6FA  8DED                            bsr hexdigit
E6FC  3502                            puls a
E6FE  840F                            anda #$0f
E700  20E7                            bra hexdigit
                      
                      * Output contents of d as four hex digits 
E702  3404            outd            pshs b   
E704  8DEE                            bsr outbyte
E706  3502                            puls a
E708  8DEA                            bsr outbyte
E70A  39                              rts
                      
                      * Skip X past spaces, B is first non-space character.
E70B  E680            skipspace       ldb ,x+
E70D  C120                            cmpb #' '
E70F  27FA                            beq skipspace
E711  39                              rts
                      
                      * Convert ascii hex digit in B register to binary Z flag set if no hex digit. 
E712  C030            convb           subb #'0'
E714  2513                            blo convexit
E716  C109                            cmpb #9
E718  230C                            bls cb2
E71A  C4DF                            andb #CASEMASK ;Make uppercase.
E71C  C007                            subb #7         ;If higher than digit 9 it must be a letter.
E71E  C109                            cmpb #9
E720  2307                            bls convexit
E722  C10F                            cmpb #15
E724  2203                            bhi convexit
E726  1CFB            cb2             andcc #$FB      ;clear zero     
E728  39                              rts
E729  1A04            convexit        orcc #$04
E72B  39                              rts
                      
E72C  DC24            scanexit        ldd temp
E72E  301F                            leax -1,x
E730  0D26                            tst temp2
E732  39                              rts             ;<-- exit point of scanhex 
                      
                      * Scan for hexadecimal number at address X return in D, Z flag is set it no
                      * number found.
E733  0F24            scanhex         clr temp    
E735  0F25                            clr temp+1
E737  0F26                            clr temp2
E739  8DD0                            bsr skipspace
E73B  BDE712          scloop          jsr convb
E73E  27EC                            beq scanexit
E740  3404                            pshs b
E742  DC24                            ldd temp
E744  58                              aslb
E745  49                              rola
E746  58                              aslb
E747  49                              rola
E748  58                              aslb
E749  49                              rola
E74A  58                              aslb
E74B  49                              rola
E74C  EBE0                            addb ,s+
E74E  DD24                            std temp
E750  0C26                            inc temp2
E752  E680                            ldb ,x+
E754  20E5                            bra scloop
                      
E756  FD029F          scan2parms      std length
E759  8DD8                            bsr scanhex
E75B  2710                            beq sp2
E75D  FD029D                          std addr
E760  8DA9                            bsr skipspace
E762  C12C                            cmpb #','
E764  2607                            bne sp2
E766  8DCB                            bsr scanhex
E768  2703                            beq sp2
E76A  FD029F                          std length                              
E76D  39              sp2             rts
                      
                      * Scan two hexdigits at in and convert to byte into A, Z flag if error.
E76E  8D9B            scanbyte        bsr skipspace
E770  8DA0                            bsr convb
E772  2712                            beq sb1
E774  1F98                            tfr b,a
E776  E680                            ldb ,x+
E778  8D98                            bsr convb
E77A  270A                            beq sb1
E77C  48                              asla
E77D  48                              asla
E77E  48                              asla
E77F  48                              asla
E780  D724                            stb temp
E782  9B24                            adda temp
E784  1CFB                            andcc #$fb      ;Clear zero flag
E786  39              sb1             rts
                      
                      
                      * This is the code for the D command, hex/ascii dump of memory
                      * Syntax: D or D<addr> or D<addr>,<length>      
E787  8E0201          dump            ldx #linebuf+1
E78A  CC0040                          ldd #$40        
E78D  BDE756                          jsr scan2parms ;Scan address and length, default length=64
E790  10BE029D                        ldy addr
E794  8610            dh1             lda #16
E796  9725                            sta temp+1      
E798  1F20                            tfr y,d
E79A  BDE702                          jsr outd
E79D  C620                            ldb #' '
E79F  9D03                            jsr putchar
E7A1  A6A0            dh2             lda ,y+         ;display row of 16 mem locations as hex
E7A3  BDE6F4                          jsr outbyte
E7A6  C620                            ldb #' '
E7A8  9625                            lda temp+1
E7AA  8109                            cmpa #9
E7AC  2602                            bne dh6
E7AE  C62D                            ldb #'-'        ;Do a - after the eighth byte.
E7B0  9D03            dh6             jsr putchar
E7B2  0A25                            dec temp+1
E7B4  26EB                            bne dh2
E7B6  3130                            leay -16,y      ;And now for the ascii dump.
E7B8  8610                            lda #16
E7BA  E6A0            dh3             ldb ,y+
E7BC  C120                            cmpb #' '
E7BE  2402                            bhs dh4
E7C0  C62E                            ldb #'.'            
E7C2  C17F            dh4             cmpb #DEL
E7C4  2502                            blo dh5
E7C6  C62E                            ldb #'.'        ;Convert all nonprintables to .
E7C8  9D03            dh5             jsr putchar
E7CA  4A                              deca
E7CB  26ED                            bne dh3
E7CD  9D0C                            jsr putcr
E7CF  FC029F                          ldd length
E7D2  830010                          subd #16
E7D5  FD029F                          std length
E7D8  22BA                            bhi dh1
E7DA  10BF029D                        sty addr
E7DE  7EE57C                          jmp cmdline
                      
                      * This is the code for the E command, enter hex bytes or ascii string.
                      * Syntax E or E<addr> or E<addr> <bytes> or E<addr>"string"
E7E1  8E0201          enter           ldx #linebuf+1
