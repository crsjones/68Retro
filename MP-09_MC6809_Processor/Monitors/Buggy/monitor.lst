EEA2  1027F6D6                        lbeq cmdline                                    
EEA6  E7A0                            stb ,y+
EEA8  20F4                            bra xlodloop
EEAA  9D12            xeq             jsr xopenin          ;XX command
EEAC  7EE57C                          jmp cmdline          ;Execute commands received from XMODEM
EEAF  CC001A          xopts           ldd #$1a
EEB2  BDE756                          jsr scan2parms
