EE76  CC0100                          ldd #$100            ;XSaddr,len command.
EE79  BDE756                          jsr scan2parms       ;Send binary through XMODEM
EE7C  9D15                            jsr xopenout
EE7E  FE029D                          ldu addr
EE81  10BE029F                        ldy length
EE85  E6C0            xsbinloop       ldb ,u+
