E88B  7EE57C                          jmp cmdline             
                      
                      * This is the code for the G command, jump to the program
                      * Syntax G or G<addr>
E88E  8E0201          go              ldx #linebuf+1
E891  BDE733                          jsr scanhex
E894  2702                            beq launch              
E896  ED6A                            std 10,s        ;Store parameter in pc location.
E898  BDE9DE          launch          jsr arm         ;Arm the breakpoints.  
E89B  35FF                            puls cc,b,a,dp,x,y,u,pc
                      
                      * This is the code for the J command, run a subroutine.
                      * Syntax J<addr>
E89D  8E0201          jump            ldx #linebuf+1
E8A0  EC6A                            ldd 10,s                
E8A2  FD029B                          std oldpc       ;Save old pc
E8A5  BDE733                          jsr scanhex
E8A8  ED6A                            std 10,s        ;Store parameter in PC location
E8AA  1F41                            tfr s,x
E8AC  327E                            leas -2,s
E8AE  1F43                            tfr s,u
E8B0  C60C                            ldb #12         ;Move the saved register set 2 addresses
E8B2  BDE44A                          jsr blockmove   ;down on the stack.
E8B5  CCE562                          ldd #stakregs
E8B8  ED6C                            std 12,s        ;Prepare subroutine return address.
E8BA  20DC                            bra launch      ;Jump to the routine.
                      
                      
                      * This is the code for the P command, run instruction followed by breakpoint
                      * Syntax P
E8BC  10AE6A          prog            ldy 10,s        ;Get program counter value.
E8BF  BDF3CC                          jsr disdecode   ;Find out location past current insn.
E8C2  10BF02AD                        sty stepbp
E8C6  20D0                            bra launch
                      
                      * This is the code for the T command, single step trace an instruction.
                      * Syntax T
E8C8  BDE8D1          trace           jsr traceone
E8CB  BDE919                          jsr dispregs
E8CE  7EE57C                          jmp cmdline
                      
E8D1  1A50            traceone        orcc #$50       ;Disable the interrupts.
E8D3  ECE1                            ldd ,s++        
E8D5  FD029B                          std oldpc       ;Remove saved pc from stack.
E8D8  CCE8ED                          ldd #traceret
E8DB  FD0287                          std firqvec+1   ;Adjust timer IRQ vector.
E8DE  13                              sync            ;Synchronize on the next timer interrupt.
                                                      ;1 cycle
E8DF  8E1159                          ldx #4441       ;3 cycles
E8E2  301F            traceloop       leax -1,x       ;6 cycles\x4441= 39969 cycles.
E8E4  26FC                            bne traceloop   ;3 cycles/
E8E6  12                              nop             ;2 cycles.
E8E7  12                              nop             ;2 cycles.
E8E8  12                              nop             ;2 cycles.
E8E9  2102                            brn traceret    ;3 cycles.
E8EB  35FF                            puls x,y,u,a,b,dp,cc,pc ;17 cycles, total=39999 20ms @ 2MHz
                                                              ;Pull all registers and execute.
                                                              ;Is timed such that next timer IRQ
                                                              ;occurs right after it.
E8ED  3501            traceret        puls cc
E8EF  347F                            pshs x,y,u,a,b,dp,cc;Store full register set instead of cc.
E8F1  CCE50E                          ldd #timerirq
E8F4  FD0287                          std firqvec+1   ;Restore timer IRQ vector.
E8F7  6E9F029B                        jmp [oldpc]
                                                      
                      
