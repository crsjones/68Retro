E96B  7EE57C                          jmp cmdline
E96E  108EE9BA        setreg          ldy #regtab     
E972  4F                              clra
E973  C4DF                            andb #CASEMASK  ;Make letter uppercase.
E975  6DA4            sr1             tst ,y
E977  1027FC5D                        lbeq unk        ;At end of register tab, unknown reg
E97B  E1A0                            cmpb ,y+
E97D  2703                            beq sr2         ;Found the register?
E97F  4C                              inca
E980  20F3                            bra sr1         
E982  3402            sr2             pshs a
E984  BDE733                          jsr scanhex     ;Convert the hex argument.
E987  3406                            pshs d
E989  A662                            lda 2,s         ;Get register number.
E98B  8104                            cmpa #4
E98D  2409                            bcc sr3         
E98F  E661                            ldb 1,s         ;It's 8 bit.            
E991  3263                            leas 3,s        ;Remove temp stuff from stack.
E993  E7E6                            stb a,s         ;Store it in the reg on stack.
E995  7EE57C                          jmp cmdline
E998  8108            sr3             cmpa #8
E99A  240C                            bcc sr4         
E99C  3510                            puls x          ;It's 16 bit.
E99E  3261                            leas 1,s
E9A0  48                              lsla
E9A1  8004                            suba #4         ;Convert reg no to stack offset.
E9A3  AFE6                            stx a,s
E9A5  7EE57C                          jmp cmdline
E9A8  3540            sr4             puls u          ;It's the stack pointer.
E9AA  3261                            leas 1,s
E9AC  3354                            leau -12,u      
E9AE  1F41                            tfr s,x
E9B0  1F34                            tfr u,s         ;Set new stack pointer.
E9B2  C60C                            ldb #12
E9B4  BDE44A                          jsr blockmove   ;Move register set to new stack location.
E9B7  7EE57C                          jmp cmdline                             
                                      
E9BA  43414244585955505320 regtab          FCC "CABDXYUPS "
                      
                      * Disarm the breakpoints, this is replace the SWI instructions with the
                      * original byte.
E9C4  8E02A1          disarm          ldx #bpaddr
E9C7  8605                            lda #brkpoints+1
E9C9  EE81            disarm1         ldu ,x++        
E9CB  E680                            ldb ,x+         ;Get address in u, byte in b
E9CD  11830000                        cmpu #0
E9D1  2702                            beq disarm2
E9D3  E7C4                            stb ,u
E9D5  4A              disarm2         deca
E9D6  26F1                            bne disarm1
E9D8  CE0000                          ldu #0
E9DB  EF1D                            stu -3,x        ;Clear the step breakpoint.
E9DD  39                              rts
                      
                      * Arm the breakponts, this is replace the byte at the breakpoint address
                      * with an SWI instruction.
E9DE  8E02AD          arm             ldx #bpaddr+brkpoints*3
E9E1  8605                            lda #brkpoints+1  ;Arm them in reverse order of disarming.
E9E3  EE84            arm1            ldu ,x       ;Get address in u.
E9E5  270D                            beq arm2
E9E7  E6C4                            ldb ,u
E9E9  E702                            stb 2,x
E9EB  11A36C                          cmpu 12,s      ;Compare to program counter location
E9EE  2704                            beq arm2
E9F0  C63F                            ldb #$3F
E9F2  E7C4                            stb ,u         ;Store SWI instruction if not equal.
E9F4  301D            arm2            leax -3,x
E9F6  4A                              deca
E9F7  26EA                            bne arm1                
E9F9  39                              rts
                      
                      * This is the code for the break command, set, clear display breakpoints.
                      * Syntax B or B<addr>. B displays, B<addr> sets or clears breakpoint.
E9FA  8604            break           lda #brkpoints
E9FC  9727                            sta temp2+1     ;Store number of breakpoints to visit.
E9FE  8E0201                          ldx #linebuf+1
EA01  BDE733                          jsr scanhex
EA04  273B                            beq dispbp      ;No number then display breakpoints
EA06  8E02A1                          ldx #bpaddr
EA09  CE0000                          ldu #0
EA0C  1F32                            tfr u,y
EA0E  10A384          bp1             cmpd ,x
EA11  2720                            beq clearit     ;Found the breakpoint, so clear it,
EA13  11A384                          cmpu ,x         ;Is location zero
EA16  2602                            bne bp2
EA18  1F12                            tfr x,y         ;Set free address to y
EA1A  3003            bp2             leax 3,x
EA1C  0A27                            dec temp2+1
EA1E  26EE                            bne bp1
EA20  108C0000                        cmpy #0         ;Address not found in list of breakpoints
EA24  2716                            beq bpfull      ;Was free address found.
EA26  EDA4                            std ,y          ;If so, store breakpoint there.
EA28  8EE612                          ldx #brkmsg     
EA2B  BDE505          bpexit          jsr outcount
EA2E  9D0C                            jsr putcr
EA30  7EE57C                          jmp cmdline
EA33  4F              clearit         clra
EA34  5F                              clrb
EA35  ED84                            std ,x
EA37  8EE621                          ldx #clrmsg
EA3A  20EF                            bra bpexit
EA3C  8EE634          bpfull          ldx #fullmsg
EA3F  20EA                            bra bpexit              
                      
EA41  8E02A1          dispbp          ldx #bpaddr
EA44  EC84            dbp1            ldd ,x
EA46  2707                            beq dbp2
EA48  BDE702                          jsr outd
EA4B  C620                            ldb #' '
EA4D  9D03                            jsr putchar
EA4F  3003            dbp2            leax 3,x
EA51  0A27                            dec temp2+1
EA53  26EF                            bne dbp1
EA55  9D0C                            jsr putcr
EA57  7EE57C                          jmp cmdline
                      
                      * Scan hex byte into a and add it to check sum in temp2+1
EA5A  BDE76E          addchk          jsr scanbyte
EA5D  10270077                        lbeq srecerr
EA61  1F89                            tfr a,b
EA63  DB27                            addb temp2+1
EA65  D727                            stb temp2+1
EA67  39                              rts
                      
                      * This tis the code for the S command, the Motorola S records entry.
                      * Syntax SO<addr> or SS<addr>,<len> or S1<bytes> or S9<bytes>
EA68  8E0201          srec            ldx #linebuf+1
EA6B  E680                            ldb ,x+
EA6D  C4DF                            andb #CASEMASK
EA6F  C14F                            cmpb #'O'
EA71  2772                            beq setsorg
EA73  C153                            cmpb #'S'
EA75  277C                            beq sendrec
EA77  E61F                            ldb -1,x
EA79  0F28                            clr temp3
EA7B  C131                            cmpb #'1'
EA7D  2706                            beq readrec
EA7F  C139                            cmpb #'9'
EA81  2655                            bne srecerr
EA83  0C28                            inc temp3               
EA85  0F27            readrec         clr temp2+1     ;clear checksum.
EA87  8DD1                            bsr addchk
EA89  8002                            suba #2         ;discount the address bytes from the count.
EA8B  9729                            sta temp3+1     ;Read length byte.
EA8D  8DCB                            bsr addchk
EA8F  3402                            pshs a
EA91  8DC7                            bsr addchk
EA93  3504                            puls b
EA95  1E89                            exg a,b         ;Read address into d.
EA97  FE02B0                          ldu sorg
EA9A  270F                            beq rr1         
EA9C  FE02B2                          ldu soffs
EA9F  260A                            bne rr1
EAA1  3406                            pshs d          ;Sorg is nonzero and soffs is zero, now
EAA3  B302B0                          subd sorg       ;set soffs
EAA6  FD02B2                          std soffs
EAA9  3506                            puls d
EAAB  B302B2          rr1             subd soffs      ;Subtract the address offset.
EAAE  1F02                            tfr d,y
EAB0  8DA8            rr2             bsr addchk      
EAB2  0A29                            dec temp3+1
EAB4  2704                            beq endrec
EAB6  A7A0                            sta ,y+
EAB8  20F6                            bra rr2
EABA  0C27            endrec          inc temp2+1     ;Check checksum.
EABC  261A                            bne srecerr
EABE  0D28                            tst temp3
EAC0  1027FAB8                        lbeq cmdline    ;Was it no S9 record?
EAC4  108C0000                        cmpy #0
EAC8  2703                            beq endrec1 
EACA  10AF6A                          sty 10,s        ;Store address into program counter.
EACD  4F              endrec1         clra
EACE  5F                              clrb
EACF  FD02B0                          std sorg        ;Reset sorg, next S loads will be normal.
EAD2  FD02B2                          std soffs
EAD5  7EE57C                          jmp cmdline     
EAD8  9D18            srecerr         jsr xabortin
EADA  8EE645                          ldx #smsg       ;Error in srecord, display message.
EADD  BDE505                          jsr outcount
EAE0  9D0C                            jsr putcr
EAE2  7EE57C                          jmp cmdline
EAE5  BDE733          setsorg         jsr scanhex     ;Set S record origin.
EAE8  FD02B0                          std sorg
EAEB  4F                              clra 
EAEC  5F                              clrb
EAED  FD02B2                          std soffs
EAF0  7EE57C                          jmp cmdline
                      * Send a memory region as S-records.
EAF3  CC0100          sendrec         ldd #$100       ;Scan address and length parameter.
EAF6  BDE756                          jsr scan2parms                          
EAF9  FC02B0                          ldd sorg
EAFC  2709                            beq ss1
EAFE  FC029D                          ldd addr
EB01  B302B0                          subd sorg
EB04  FD02B2                          std soffs       ;Compute offset for origin.
EB07  FC029F          ss1             ldd length      
EB0A  2748                            beq endss       ;All bytes sent?
EB0C  10830010                        cmpd #16
EB10  2502                            blo ss2         
EB12  C610                            ldb #16         ;If more than 16 left, then send 16.
EB14  D724            ss2             stb temp
EB16  50                              negb
EB17  FE029F                          ldu length
EB1A  33C5                            leau b,u
EB1C  FF029F                          stu length      ;Discount line length from length.
EB1F  C653                            ldb #'S'
EB21  9D03                            jsr putchar
EB23  C631                            ldb #'1'
EB25  9D03                            jsr putchar
EB27  0F25                            clr temp+1      ;Clear check sum
EB29  D624                            ldb temp
EB2B  CB03                            addb #3
EB2D  8D30                            bsr checkout    ;Output byte b as hex and add to check sum.
EB2F  FC029D                          ldd addr
EB32  1F02                            tfr d,y
EB34  B302B2                          subd soffs
EB37  1E89                            exg a,b
EB39  8D24                            bsr checkout
EB3B  1E89                            exg a,b
EB3D  8D20                            bsr checkout    ;Output address (add into check sum)
EB3F  E6A0            ss3             ldb ,y+
EB41  8D1C                            bsr checkout
EB43  0A24                            dec temp
EB45  26F8                            bne ss3
EB47  10BF029D                        sty addr
EB4B  D625                            ldb temp+1
EB4D  53                              comb
EB4E  8D0F                            bsr checkout    ;Output checksum byte.
EB50  9D0C                            jsr putcr
EB52  20B3                            bra ss1
EB54  8EE657          endss           ldx #lastrec
EB57  BDE505                          jsr outcount
EB5A  9D0C                            jsr putcr
EB5C  7EE57C                          jmp cmdline
