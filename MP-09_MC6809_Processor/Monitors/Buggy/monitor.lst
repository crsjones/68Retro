F9B7  8602                            lda #2          ;Then we have postbyte and opsize=2
F9B9  B702CB                          sta opsize
F9BC  868F                            lda #$8F
F9BE  B702C2                          sta postbyte    
F9C1  2005                            bra opsz4
F9C3  8602            opsz3           lda #2
F9C5  B702C3                          sta amode       ;Assume direct or absolute addressing 
F9C8  E680            opsz4           ldb ,x+         
F9CA  C12C                            cmpb #','
F9CC  10270086                        lbeq doindex    ;If followed by, then indexed.
F9D0  B602C3          scanend         lda amode
F9D3  8105                            cmpa #5
F9D5  2510                            blo scanend2    ;Was it an indirect mode?
F9D7  B602C2                          lda postbyte
F9DA  8A10                            ora #$10        ;Set indirect bit.
F9DC  B702C2                          sta postbyte
F9DF  E680                            ldb ,x+         
F9E1  C15D                            cmpb #']'       ;Check for the other ]
F9E3  102701D0                        lbeq moderr
F9E7  39              scanend2        rts
F9E8  BD0295          doimm           jsr exprvec     ;Immediate addressing.  
F9EB  102701C2                        lbeq exprerr
F9EF  FD02C4                          std operand
F9F2  B602C3                          lda amode
F9F5  8105                            cmpa #5
