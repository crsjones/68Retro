FAB2  C689                            ldb #$89
FAB4  FA02C2                          orb postbyte
FAB7  F702C2                          stb postbyte
FABA  16FF13                          lbra scanend
FABD  E680            dopcrel         ldb ,x+
FABF  C4DF                            andb #CASEMASK  ;Convert to uppercase
FAC1  C143                            cmpb #'C'
FAC3  2506                            blo pcrelend
FAC5  C152                            cmpb #'R'
FAC7  2202                            bhi pcrelend
