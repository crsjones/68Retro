1008                         
1009 ffca a4                        FCB    EXEC-ROMBAS
1010 ffcb a7                        FCB    REGS-ROMBAS
1011 ffcc 1c                        FCB    PNCH1-ROMBAS
1012 ffcd 44                        FCB    MEM-ROMBAS
1013 ffce fd                        FCB    LOAD-ROMBAS
1014 ffcf 45                        FCB    INST-ROMBAS
1015 ffd0 00                        FCB    GO-ROMBAS
1016 ffd1 1b                        FCB    PUNCH-ROMBAS
1017 ffd2 88                        FCB    REGX-ROMBAS
1018 ffd3 86                        FCB    REGP-ROMBAS
1019 ffd4 f9                        FCB    LOAD1-ROMBAS
1020 ffd5 8c                        FCB    REGC-ROMBAS
1021 ffd6 8b                        FCB    REGB-ROMBAS
1022 ffd7 8a                        FCB    REGA-ROMBAS
1023                         
1024                         **     OPCODE TABLE - ONE BIT PER INSTRUCTION
1025                         
1026 ffd8 9c 00 3c af 40 00  OPTAB  FDB    $9C00,$3CAF,$4000,$00AC
     00 ac
1027 ffe0 64 12 64 12 64 10         FDB    $6412,$6412,$6410,$6410
     64 10
1028 ffe8 11 01 10 04 10 00         FDB    $1101,$1004,$1000,$1000
     10 00
1029 fff0 11 0d 10 0c 10 0c         FDB    $110D,$100C,$100C,$100C
     10 0c
1030                         
