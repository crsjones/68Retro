0610 fdd4 8d b7                     BSR    PUNT2
0611 fdd6 30                        TSX
0612 fdd7 6c 02                     INC    2,X      INCREENT ADDRESS POINTER ON STACK
0613 fdd9 26 02                     BNE    PNCH11
0614 fddb 6c 01                     INC    1,X
0615 fddd 6a 00              PNCH11 DEC    0,X
0616 fddf 2a ea                     BPL    PNCH85
0617 fde1 32                        PULA            $FF INTO A
0618 fde2 6d 03                     TST    3,X      CHECKSUM?
0619 fde4 27 03                     BEQ    PNCH4
0620 fde6 10                        SBA             B-BAR INTO A
0621 fde7 8d a9                     BSR    THB0
0622 fde9 30                 PNCH4  TSX
