0626 fdf0 a2 00                     SBCA   0,X
0627 fdf2 22 be                     BHI    PNCH7    MORE THAN 256
0628 fdf4 24 b8                     BCC    PNCH6    MORE THAN ZERO
0629 fdf6 32                        PULA
0630 fdf7 32                        PULA
0631 fdf8 32                        PULA
