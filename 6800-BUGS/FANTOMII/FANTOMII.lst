0798                         **     SSTEP - PERFORM SINGLE STEP
0799                         *
0800                         *        THIS SUBROUTINE MAY BE CALLED TO EXECUTE A
0801                         *          SINGLE INSTRUCTION FROM THE USER CODE. ILLEGAL
0802                         *          INSTRUCTIONS ARE CHECkED AND THE STEP ROUTINE
0803                         *          REFUSES TO EXECUTE THEM.
0804                         *
0805                         *        MOST INSTRUCTIONS ARE EXECUTED OUT-OF-PLACE;
0806                         *          SOME INSTRUCTIONS (THOSE WHICH INVOLVE THE
0807                         *          P.C.) MUST BE INTERPRESTED. A SET OF HANDLERS
0808                         *          IS INCLUDED  FOR THIS SET OF INSTRUCTIONS
0809                         
0810 fec1 bf dd ee           SSTEP  STS    TEMP     WE'LL USE THIS TO RETURN
0811 fec4 8d c5                     BSR    LDXU
0812 fec6 a6 07                     LDAA   7,X      PUSH USER PC ONTO STACK
0813 fec8 36                        PSHA
0814 fec9 a6 06                     LDAA   6,X
0815 fecb 36                        PSHA
0816 fecc ee 06                     LDX    6,X      NOW GET USER PC INTO X
0817 fece 86 3f                     LDAA   #$3f     SWI'S ARE NORMAL EXIT FROM
0818 fed0 36                        PSHA              SCRATCH PAD EXECUTE
0819 fed1 36                        PSHA
0820 fed2 a6 02                     LDAA   2,X      COPY 3 BYTES OF PROGRAM
0821 fed4 36                        PSHA
0822 fed5 a6 01                     LDAA   1,X
0823 fed7 36                        PSHA
0824 fed8 a6 00                     LDAA   0,X      OP CODE SO
0825 feda 36                        PSHA              SO SCRUTINIZE CAREFULLY
0826 fedb 8d b2                     BSR    BYTCNT
0827 fedd 27 75                     BEQ    BSTRD
0828 fedf 30                        TSX
0829 fee0 25 02                     BCS    STEP1
0830 fee2 e7 01                     STAB   1,X      BRANCH OFFSET TO 2
0831 fee4 86 01              STEP1  LDAA   #1
0832 fee6 c1 02                     CMPB   #2
0833 fee8 2e 06                     BGT    STEP3
0834 feea 27 02                     BEQ    STEP2    TWO BYTES
0835 feec a7 01                     STAA   1,X      FOR ONE BYTERS
0836 feee a7 02              STEP2  STAA   2,X      NOT FOR THREE BYTERS
0837 fef0 4f                 STEP3  CLRA            NOW ADD BYTE COUNT TO PC
0838 fef1 eb 06                     ADDB   6,X
0839 fef3 a9 05                     ADCA   5,X
0840 fef5 a7 05                     STAA   5,X
0841 fef7 e7 06                     STAB   6,X
0842                         
0843                         *      DOES THE INSTRUCTION INVOLVE THE PC?
0844                         *        IF SO THEN IT MUST BE INTERPRET
0845                         
0846 fef9 8d 90              STEP4  BSR    LDXU
0847 fefb a7 06                     STAA   6,X
0848 fefd e7 07                     STAB   7,X      UPDATE PC ON USER STACK
0849 feff c6 06                     LDAB #6
0850 ff01 32                        PULA
0851 ff02 36                        PSHA            GET COPY OF OPCODE
0852 ff03 84 cf                     ANDA   #$CF     IS THIS A SUBROUTINE CALL?
0853 ff05 81 8d                     CMPA   #$8D
0854 ff07 32                        PULA
0855 ff08 27 4e                     BEQ    BSRH
0856 ff0a 81 6e                     CMPA   #$6E
0857 ff0c 27 62                     BEQ    JPXH     IT IS INDEXED JUMP
0858 ff0e 81 7e                     CMPA   #$7E 
0859 ff10 27 65                     BEQ    JMPH     IT IS EXTENDED JUMP
0860 ff12 81 39                     CMPA   #$39
0861 ff14 27 69                     BEQ    RTSH     IT IS RTS
0862 ff16 81 3b                     CMPA   #$3B
0863 ff18 27 74                     BEQ    RTIH     IT IS RTI
0864 ff1a 81 3f                     CMPA   #$3F
0865 ff1c 27 76                     BEQ    SWIH     IT IS SWI
0866 ff1e af 06                     STS    6,X      AIM USER PC AT SCRATCH AREA
0867 ff20 36                        PSHA            REPLACE OPCODE
0868 ff21 ce ff 30                  LDX    #SSRET 
