0008                         ****    PAGE
0009                         ***Keywords for A09 compiler (arakula from Github)
0010                         * https://github.com/Arakula/A09
0011                         * compiles under Motorola compiler as well - see options above
0012                         *      *      *        *
0013                         *23456789012345678901234567890
0014                         *        SETLI 132
0015                                 NAM    FANTOMII
0016                         *
0017                         * FANTOM-II is a 1-K byte loader/monitor/debugger program for the 6800.
0018                         * It can be supplied in a ROM or 2708 EPROM, or as firmware
0019                         * on the WINCE Control Module.
0020                         * FANTOM-II supports commands below entered from a teletype or equivalent
0021                         * terminal such as the WINTEK Model BRB video terminal or 
0022                         * Texas Instrument ASR 700 (Silent 700)
0023                         *
0024                         * Note: To relocate - specify scratch pad RAM area, ACIA, and ROM start address
0025                         *
0026                         * Commands:
0027                         *      M - Display/Change Memory
0028                         *      R - Display/Change Instruction
0029                         * CNTL-A - DISPLAY/Change Accumulator A
0030                         * CNTL-B - DISPLAY/Change Accumulator B
0031                         * CNTL-C - DISPLAY/Change Condition Codes Register
0032                         * CNTL-P - DISPLAY/Change Program Counter
0033                         * CNTL-X - DISPLAY/Change Index Register
0034                         *      G - Go To User Program
0035                         *      S - Single Step User Program
0036                         *      D - Dump Memory
0037                         *      P - Punch Loader Compatible Tape
0038                         *      L - Load Memory
0039                         *
0040                         * WINTEK Copyright 1976
0041                         * WINTEK CORP.
0042                         * 902 N. 9 St.
0043                         * LAFAYETTE, IN 47904
0044                         * 317-742-6802
0045                         * Orig Author Jim Wilson, WINTEK
0046                         *
0047                         * WINCE 6800 Module RAM $ED80-$EDFF
0048                         *                       $0000-$017F
0049                         * FANTOM II
0050                         * RAM DECLARATIONS
0051                         *       ORG    $EDBE
0052 ddbe                           ORG    $DDBE
0053 ddbd                    USRSTK EQU    *-1      INITIAL VALUE OF USER S.P.
0054 ddbe                    USRCCR RMB    1        INITIAL LOCATIONS OF USER
0055 ddbf                    USRACB RMB    1         REGISTERS - VALID ON POWER
0056 ddc0                    USRACA RMB    1          UP ONLY!!! USER MAY
0057 ddc1                    USRIND RMB    2           CHANGE SUBSEQUENTLY
0058 ddc3                    USRPCT RMB    2
0059 ddc5                           RMB    37       MONITOR STACK ARES
0060 dde9                    MONSTK EQU    *-1      INITIAL MONITOR S.P.
0061 ddea                    END    RMB    2        PUNCH END ADDRESS
0062 ddec                    BEG    RMB    2        PUNCH BEG ADDRESS
0063 ddee                    TEMP   RMB    2        PUNCH BEG ADDRESS
0064 ddf0                    USERS  RMB    2        TEMP WORK AREA
0065 ddf2                    TEM1   RMB    2        MONITOR STACK POINT STORE
0066 ddf4                    SYSSWI RMB    3        SYSTEM SWI VECTOR
0067 ddf7                    UIRQ   RMB    3        USER IRQ VECTOR
0068 ddfa                    USWI   RMB    3        USER SWI VECTOR
0069 ddfd                    UNMI   RMB    3        USER NMI VECTOR
0070                         
0071                         
0072                         **      ACIA ADDRESSES.
0073                          
0074 ee08                    ACIACR EQU    $EE08
0075 ee08                    ACIASR EQU    $EE08
0076 ee09                    ACIADR EQU    $EE09
0077                         
0078                         **     FANTOM COMMAND HANDLES RULES:
0079                         **     ALL FANTOM COMMAND HANDLERS MUST HAVE THEIR
0080                         *      ENTRY POINTS INSIDE THE SAME 256 BYTE PAGE
0081                         *      OF ROM SO THAT THEIR ENTRY POINT ADDRESS
0082                         *      MAY BE STORED IN A SINGLE BYTE.
0083                         *
0084                         *      ALL HANDLERS ARE CALLED WITH AN EFFECTIVE
0085                         *      -JSR- AND HAVE THE FOLLOWING ADDITIONAL
0086                         *      REQUIREMENTS:
0087                         *
0088                         *        ENTRY:  (B) = 0
0089                         *                (X) = (USER STACK POINTER)
0090                         *                (A) = ASCII COMMAND CHARACTER
0091                         
0092 fc00                           ORG    $FC00
0093 fc00                    ROMBAS EQU    *
0094                         
0095                         **     GO--GO TO USER PROGRAM
0096                         *
0097                         *        ACCEPTS HEX ADDRESSES, INSERTS BREAKPOINTS,
0098                         *         SETS UP SWI RETURN AND
0099                         *          BEGINS EXECUTION OF USER CODE
0100                         *
0101                         *        ENTRY--(B) = 0
0102                         *                  ROM (RETURN) ADDRESS ONTO STACK
0103                         *                   WE WILL TRY TO CLEAR THIS LOCATION
0104                         *
0105                         *        EXIT--REMOVES BREAKPOINTS AND RETURNS TO
0106                         *                 THE MAIN MONITOR LOOP
0107                         *
0108                         *        USES--ALL REGISTERS
0109                         
0110 fc00 ce dd fa           GO     LDX    #USWI    INCASE NO BREAKPOINTS
0111 fc03 20 0e                     BRA    GO2
0112 fc05 36                 GO1    PSHA
0113 fc06 37                        PSHB
0114 fc07 30                        TSX
0115 fc08 ee 00                     LDX    0,X
0116 fc0a e6 00                     LDAB   0,X
0117 fc0c 86 3f                     LDAA   #$3F     REPLACE OPCODE WITH SWI
0118 fc0e a7 00                     STAA   0,X
0119 fc10 ce fe 4f                  LDX    #GO5     BREAKPOINTS ARE ALIVE
0120 fc13 37                 GO2    PSHB
0121 fc14 8d 4e                     BSR    AHV
0122 fc16 25 ed                     BCS    GO1
0123 fc18 7e fe 49                  JMP    GO4      GIVES CONTROL TO USER CODE
0124                         
0125                         **     PUNCH--PROCESS PUNCH COMMAND
0126                         *        ENTRY--DEFAULT VALUES ON STACK BELOW RET. ADDRESS
0127                         *
0128                         *                 RETURN ADDRESS
0129                         *                 RETURN ADDRESS
0130                         *                 END ADDRESS
0131                         *                 END ADDRESS (LO)
0132                         *                 BEG ADDRESS
0133                         *                 BEG ADDRESS (LO)
0134                         *
0135                         *        EXIT--AFTER ACCEPTING USER SPECIFIED BEGINNING
0136                         *                AND ENDING ADDRESSES, THIS SUBROUTINE
0137                         *                   PUNCHES OR DUMPS, AND THEN RETURNS
0138                         *                      TO THE CALLING ROUTINE. IT IS
0139                         *                          CALLERS RESPONSIBILITY TO
0140                         *                              CLEAN UP STACK
0141                         *
0142                         
0143 fc1b 4f                 PUNCH  CLRA            DUMP WITH SPACES
0144 fc1c 5c                 PNCH1  INCB            NORMAL DUMP
0145 fc1d 36                        PSHA            
0146 fc1e 37                        PSHB
0147 fc1f 30                        TSX
0148 fc20 8d 42                     BSR    AHV      GET BEGINNING ADDRESS
0149 fc22 24 0a                     BCC    PNCH2    USE DEFAULT INSTEAD
0150 fc24 a7 07                     STAA   7,X      STORE BEGINNING ADDRESS
0151 fc26 e7 06                     STAB   6,X
0152 fc28 8d 3a                     BSR    AHV      END ADDRESS
0153 fc2a a7 05                     STAA   5,X
0154 fc2c e7 04                     STAB   4,X
0155 fc2e 32                 PNCH2  PULA            NOW SET UP ACIA
0156 fc2f 6d 01                     TST    1,X
0157 fc31 27 08                     BEQ    PNCH3
0158 fc33 b7 ee 08                  STAA   ACIACR
0159 fc36 86 12                     LDAA   #$12     TAPE ON
0160 fc38 bd fd 80                  JSR    OUTCH
0161 fc3b a6 07              PNCH3  LDAA   7,X
0162 fc3d 36                        PSHA
0163 fc3e a6 06                     LDAA   6,X      CURRENT ADDRESS ONTO STACK
0164 fc40 36                        PSHA
0165 fc41 7e fd e9                  JMP    PNCH4
0166 fc44 5a                 MEM    DECB            BYTE DISPLAY
0167 fc45 37                 INST   PSHB            INSTRUCTION DISPLAY
0168 fc46 ee 06                     LDX    6,X
0169 fc48 8d 1a                     BSR    AHV
0170 fc4a 24 07                     BCC    MEM1
0171 fc4c 36                        PSHA
0172 fc4d 37                        PSHB
0173 fc4e 30                        TSX
0174 fc4f ee 00                     LDX    0,X
0175 fc51 31                        INS
0176 fc52 31                        INS
0177 fc53 0c                 MEM1   CLC             INSURES WE BRANCH
0178 fc54 33                 MEM2   PULB            RETRIEVE MODE FLAG
0179 fc55 24 03                     BCC    MEM3
0180 fc57 8d 43                     BSR    STORE0
0181 fc59 08                        INX
0182 fc5a bd fd 5b           MEM3   JSR    TYPINS   TYPE THE DATA
0183 fc5d 37                        PSHB
0184 fc5e 8d 04                     BSR    AHV      GET REPLACEMENT VALUE
0185 fc60 23 f2                     BLS    MEM2     IF CR OR VALID ENTRY
0186 fc62 33                 MEM4   PULB
0187 fc63 39                        RTS
0188                         
0189                         **     AHV - ACCUMULATE HEX VALUE
0190                         *
0191                         *        READS HEX DIGITS FROM THE KEYBOARD; ACCUMULATES
0192                         *        THEM INTO A 16 BIT VALUE.
0193                         *
0194                         *        ENTRY:  NONE
0195                         *
0196                         *        EXIT    (BA) = ACCUMULATED VALUE IF VALID ENTRY
0197                         *                 (A) = ASCII VALUE OTHERWISE
0198                         *                'C' CLEAR IF NO VALID ENTRY
0199                         *                'Z' SET IF LAST CHARACTER TYPED WAS 'CR'
0200                         *
0201                         *        USES:   A,B,C
0202                         
0203 fc64 5f                 AHV    CLRB
0204 fc65 8d 6b                     BSR    IHD      GET FIRST DIGIT
0205 fc67 24 1c                     BCC    AHV3
0206 fc69 36                 AHV1   PSHA
0207 fc6a 37                        PSHB
0208 fc6b 48                        ASLA
0209 fc6c 59                        ROLB
0210 fc6d 48                        ASLA
0211 fc6e 59                        ROLB
0212 fc6f 48                        ASLA
0213 fc70 59                        ROLB
0214 fc71 48                        ASLA
0215 fc72 59                        ROLB
0216 fc73 37                        PSHB
0217 fc74 36                        PSHA            MAKE WAY FOR NEXT DIGIT
0218 fc75 8d 5b                     BSR    IHD
0219 fc77 24 07                     BCC    AHV2     THAT'S ALL FOLKS
0220 fc79 33                        PULB
0221 fc7a 1b                        ABA
0222 fc7b 33                        PULB
0223 fc7c 31                        INS             SKIP PREVIOUS VALUE
0224 fc7d 31                        INS
0225 fc7e 20 e9                     BRA    AHV1
0226 fc80 31                 AHV2   INS             SKIP LATEST VALUE
0227 fc81 31                        INS
0228 fc82 33                        PULB
0229 fc83 32                        PULA            GET OLD VALUE
0230 fc84 0d                        SEC
0231 fc85 39                 AHV3   RTS
0232                         
0233                         **     REG - REGISTER DISPLAY COMMANDS
0234                         *
0235                         *        ENTRY:   (X) = USER STACK POINTER
0236                         *                 (B) = 0
0237                         *
0238                         *        EXIT:    REGISTER CHANGED IF VALID HEX
0239                         *                    UNCHANGED OTHERWISE
0240                         
0241 fc86 08                 REGP   INX
0242 fc87 08                        INX
0243 fc88 08                 REGX   INX
0244 fc89 5c                        INCB
0245 fc8a 08                 REGA   INX
0246 fc8b 08                 REGB   INX
0247 fc8c 8b 40              REGC   ADDA   #$40  
0248 fc8e 8d 37                     BSR    PTREGA
0249 fc90 37                        PSHB
0250 fc91 8d d1                     BSR    AHV      GET REPLACEMENT VALUE
0251 fc93 24 cd                     BCC    MEM4     NO REPLACE - PUL B, RTS
0252 fc95 8d 05                     BSR    STORE0
0253 fc97 17                        TBA
0254 fc98 33                        PULB
0255 fc99 5a                        DECB
0256 fc9a 27 07                     BEQ    STORE1
0257                         
0258                         **     STORE - STORE AND CHECK BYTE
0259                         *
0260                         *        ENTRY: (X) = ADDRESS TO STORE
0261                         *
0262                         *        EXIT:  (A) STORED AT ADDRESS
0263                         *                  ERROR RETURNS TO MAIN MONITOR LOOP
0264                         *
0265                         *        USES:  C
0266                         
0267 fc9c 09                 STORE0 DEX
0268 fc9d a7 00              STORE  STAA   0,X
0269 fc9f a1 00                     CMPA   0,X
0270 fca1 26 4e                     BNE    LOAD7
0271 fca3 39                 STORE1 RTS
0272                         
0273                         **     EXEC - PROCESS 'EXEC' COMMAND.
0274                         *
0275                         *        HERE WE CALL 'SSTEP' TO EXECUTE ONE INSTRUCTION
0276                         *         FROM THE USER CODE AND THEN RETURN TO PRINT
0277                         *          HIS REGISTERS
0278                         
0279 fca4 bd fe c1           EXEC   JSR    SSTEP
0280                         
0281                         ***    REGS - DISPLAY ALL REGISTERS.
0282                         *
0283                         *        PRINTS REGISTERS IN THE FORM:
0284                         *
0285                         *        'C=__ B=__ A=__ X=____ P=____ S=____'
0286                         
0287 fca7 bd fe 8a           REGS   JSR    CLBLDX
0288 fcaa 86 43                     LDAA   #'C'
0289 fcac 8d 19                     BSR    PTREGA
0290 fcae 86 42                     LDAA   #'B'
0291 fcb0 8d 17                     BSR    PTREG
0292 fcb2 86 41                     LDAA   #'A'
0293 fcb4 8d 13                     BSR    PTREG
0294 fcb6 86 58                     LDAA   #'X'
0295 fcb8 8d 0e                     BSR    PTREGB
0296 fcba 86 50                     LDAA   #'P'
0297 fcbc 8d 0b                     BSR    PTREG
0298 fcbe 86 53                     LDAA   #'S'
0299 fcc0 09                        DEX
0300 fcc1 ff dd ee                  STX    TEMP
0301 fcc4 ce dd ed                  LDX    #TEMP-1
0302                         
0303                         **     OUTPUT ROUTINES
0304                         *
0305                         *        ENTRY: (A) = REGISTER NAME
0306                         *               (X) = ADDRESS OF STORED REG
0307                         *               (B) = NUMBER BYTES TO PRINT
0308                         *
0309                         *        EXIT:  REGISTER PRINTED
0310                         *               (X) = ADDRESS OF NEXT REGISTER
0311                         *
0312                         *        USERS: A,X
0313                         
0314 fcc7 08                 PTREGA INX             SKIP A BYTE FIRST
0315 fcc8 5c                 PTREGB INCB            PRINT MORE BYTES
0316 fcc9 8d 78              PTREG  BSR    OUTCHA   ENTRY CONDITIONS APPLY HERE
0317 fccb 86 3d                     LDAA   #'='
0318 fccd 8d 74                     BSR    OUTCHA
0319 fccf 7e fd 74                  JMP    OUTREG
0320                         
0321                         **     IHD - INPUT HEX DIGIT
0322                         *
0323                         *        INPUTS A DIGIT FROM THE CONSOLE; CHECKS TO SEE
0324                         *        IF IT IS A VALID HEX DIGIT
0325                         *
0326                         *        ENTRY: NONE
0327                         *
0328                         *        EXIT:  (A) = HEX VALUE IF VALID ENTRY
0329                         *                   = ASCII VALUE OTHERWISE
0330                         *               'C' SET IF HEX
0331                         *               'Z' SET IF CR
0332                         
0333 fcd2 8d 62              IHD    BSR    INCH
0334 fcd4 81 20                     CMPA   #' '
0335 fcd6 27 fa                     BEQ    IHD
0336 fcd8 80 30                     SUBA   #'0'
0337 fcda 25 0c                     BCS    IHD1     LESS THAN ZERO
0338 fcdc 81 0a                     CMPA   #10
0339 fcde 25 7a                     BCS    IHD3     ZERO THRU NINE
0340 fce0 80 11                     SUBA   #'A-'0 DISLACE A TO ZERO
0341 fce2 81 06                     CMPA   #6
0342 fce4 25 72                     BCS    IHD2     A THRU F
0343 fce6 8b 11                     ADDA   #'A-'0
0344 fce8 8b 30              IHD1   ADDA   #'0'     DISPLACE BACK
0345 fcea 81 0d                     CMPA   #$D      SET 'Z' IF CR
0346 fcec 0c                        CLC
0347 fced 39                        RTS
0348                         
0349                         **     LOAD - PROCESS *LOAD* COMMAND.
0350                         *
0351                         *        LOADS MEMORY FROM CASSETTE OR PAPER TAPE
0352                         *            IN THE MIKBUG(TM) FORMAT
0353                         *
0354                         *        ENTRY: (B) = 0
0355                         *
0356                         *        EXIT:  VIA RTS EXCEPT ON ERROR - THEN TO
0357                         *               MAIN MONITOR LOOP.
0358                         *
0359                         *        USES:  ALL
0360                         *
0361                         *        ALL DONE - CHECK CHECKSUM
0362                         
0363 fcee 4c                 LOAD5  INCA
0364 fcef 27 15                     BEQ    LOAD3
0365                         *      ERROR RETURN JUMPS HERE
0366 fcf1 bd fd a6           LOAD7  JSR CRLF
0367 fcf4 86 3f                     LDAA   #'?'
0368 fcf6 7e fe 2e                  JMP    MAIN1
0369                         *      NORMAL ENTRY IS AT 'LOAD'
0370                         *      OPTIONAL CASSETTE ENTRY IS 'LOAD1'
0371                         
0372 fcf9 5a                 LOAD1  DECB            CASSETTE ENTRY
0373 fcfa f7 ee 08                  STAB   ACIACR   RESET ACIA
0374 fcfd cb 09              LOAD   ADDB   #$9      NORMAL ENTRY
0375 fcff f7 ee 08                  STAB   ACIACR   FIX ACIA
0376 fd02 86 11                     LDAA   #$11     READER-ON
0377 fd04 8d 3d                     BSR    OUTCHA
0378 fd06 8d 2e              LOAD3  BSR    INCH
0379 fd08 81 53                     CMPA   #'S'
0380 fd0a 26 fa                     BNE    LOAD3
0381 fd0c 8d 28                     BSR    INCH
0382 fd0e 80 39                     SUBA   #'9'
0383 fd10 27 48                     BEQ    IHD3     RETURN TO CALLER
0384 fd12 80 f8                     SUBA   #'1-'9 CLEARS A if S1
0385 fd14 26 f0                     BNE    LOAD3
0386                         
0387                         *      WE HAVE 'S1' -- A WILL BE CHECKSUM
0388                         
0389 fd16 8d 2d                     BSR    IHB      GET BYTE COUNT
0390 fd18 c0 02                     SUBB   #2
0391 fd1a f7 dd f2                  STAB   TEM1
0392 fd1d 8d 26                     BSR    IHB      GET ADDRESS
0393 fd1f 37                        PSHB
0394 fd20 37                        PSHB
0395 fd21 8d 22                     BSR    IHB
0396 fd23 30                        TSX
0397 fd24 e7 01                     STAB   1,X
0398 fd26 ee 00                     LDX    0,X
0399 fd28 31                        INS
0400 fd29 31                        INS              PLACE INTO X REG
0401 fd2a 8d 19              LOAD4  BSR    IHB       GET NEXT BYTE
0402 fd2c 7a dd f2                  DEC    TEM1
0403 fd2f 27 bd                     BEQ    LOAD5
0404 fd31 e7 00                     STAB   0,X
0405 fd33 08                        INX
0406 fd34 20 f4                     BRA    LOAD4
