0870                         **     SWIVE1--SET UP SWI RETURN; JUMP TO USER CODE
0871                         *
0872                         *        ENTRY:--(X) = SWI VECTOR
0873                         *
0874                         *        EXIT: --TO USER PROGRAM
0875                         
0876 ff24 86 7e              SWIVE1 LDAA   #$7E     JUMP OP CODE
0877 ff26 b7 dd f4                  STAA   SYSSWI
0878 ff29 ff dd f5                  STX    SYSSWI+1
0879 ff2c be dd f0                  LDS    USERS
0880 ff2f 3b                        RTI
0881                         
0882                         *      THE FOLLOWING CODE IS EXECUTED AFTER EXECUTION
0883                         *        OF AN OUT-OF-PLACE INSTRUCTION.  HERE WE CHECK
0884                         *          TO SEE IF A BRANCH HAS OCCURRED and MODIFY
0885                         *            USER'S P.C. ACCORDINGLY
0886                         
0887 ff30 30                 SSRET  TSX             GET SWI HIT LOCATION INTO X
0888 ff31 ee 05                     LDX   5,X
0889 ff33 08                        INX
0890 ff34 4f                        CLRA
0891 ff35 5f                        CLRB
0892 ff36 bc dd ee                  CPX   TEMP
0893 ff39 26 0c                     BNE   BCHNTK
0894                         
0895                         *      ADD THE BRANCH OFFSET TO THE USER PC
0896                         
0897 ff3b 09                        DEX             X WILL NOW POINT AT USERPC
0898 ff3c ee 00                     LDX   0,X       SAVED VALUE OF PC INTO X
0899 ff3e 09                        DEX             FETCH BRANCH OFFSET
0900 ff3f e6 00                     LDAB  0,X
0901 ff41 2a 01                     BPL   PLUS
0902 ff43 43                        COMA            A IS SIGN EXTENSION OF B
0903 ff44 30                 PLUS   TSX             POINT TO USERPC
0904 ff45 ee 05                     LDX   5,X
0905 ff47 eb 01              BCHNTK ADDB  1,X       ADD BRANCH OFFSET OR 0
0906 ff49 a9 00                     ADCA  0,X
0907 ff4b 30                        TSX             PLACE NEW USERPC ONTO STACK
0908 ff4c a7 05                     STAA  5,X
0909 ff4e e7 06                     STAB  6,X
0910 ff50 09                        DEX             NOW X AND SP ARE EQUAL
0911 ff51 ff dd f0           STOX   STX   USERS
0912 ff54 be dd ee           BSTRD  LDS   TEMP
0913 ff57 39                        RTS             RETURN TO CALLING ROUTINE
0914                         
0915                         **     SPECIAL HANDLERS
0916                         **     BSRH, JSRH - SUBROUTINE CALL HANDLERS
0917                         
0918 ff58 81 8d              BSRH   CMPA  #$8D      IS IT BSR
0919 ff5a 26 02                     BNE   JSRH
0920 ff5c 86 5f                     LDAA  #$5F      THIS CONVERTS BSR'S to BRA'S
0921 ff5e 80 3f              JSRH   SUBA  #$3F       JSR'S TO JUMPS
0922 ff60 36                        PSHA            CORRECTED OPCODE ONTO STACK
0923 ff61 09                        DEX
0924 ff62 09                        DEX
0925 ff63 ff dd f0                  STX   USERS
0926 ff66 a6 03              JSRH1  LDAA  3,X
0927 ff68 a7 01                     STAA  1,X       MOVE USER REGISTERS
0928 ff6a 08                        INX
0929 ff6b 5a                        DECB
0930 ff6c 2a f8                     BPL   JSRH1
0931 ff6e 20 89                     BRA   STEP4     NOW EXECUTE JUMP INSTRUCT
0932                         
