0507                         *
0508                         *        ENTRY:  NONE
0509                         *
0510                         *        EXIT:   (A) = SPACE
0511                         *
0512                         *        USES:   A,C
0513                         
0514 fd7e 86 20              OUTSP  LDAA   #' '
0515                         
