0678                         *        COMMANDS;   ENTRY 'MAIN' IS ERROR RETURN
0679                         
0680 fe2d 4f                 MAINLP CLRA            (A) SENT BEFORE PROMPT
0681 fe2e 8e dd e9           MAIN1  LDS    #MONSTK    ENTER HERE FOR ERROR
0682 fe31 c6 41                     LDAB   #$41      7+E+2, 1/16, RTS FALSE
0683 fe33 f7 ee 08                  STAB   ACIACR
0684 fe36 ce ff a9                  LDX    #PMTMSG
0685 fe39 8d 37                     BSR    CMDEX
