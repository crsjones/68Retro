0650                         **     RESET -- POWER ON/USER CRASH RESET ROUTINE
0651                         *
0652                         *            SET UP ACIA, CHECK IF BREAKPOINTS ALIVE
0653                         *               AND ATTEMPT TO ClEAR THEM
0654                         
0655 fe07 ce ee 07           RESET  LDX    #ACIACR-1
0656 fe0a ef 00                     STX    0,X      RESET ACIA
0657 fe0c 09                 RESET1 DEX             RESET DELAY
0658 fe0d 26 fd                     BNE RESET1
0659                         
0660                         *      NOW TRY TO CLEAR ALL BREAKPOINTS
0661                         
0662 fe0f 8e dd bd                  LDS    #USRSTK
0663 fe12 bf dd f0                  STS    USERS    INITIALIZE FOR USER
0664 fe15 be dd f2                  LDS    TEM1
0665 fe18 fe dd f5           RESET2 LDX    SYSSWI+1 SEE IF BREAKPOINTS ACTIVE
0666 fe1b 7f dd f5                  CLR    SYSSWI+1
0667 fe1e 8c fe 4f                  CPX    #GO5
0668 fe21 26 0a                     BNE    MAINLP
0669 fe23 32                 RESET3 PULA
0670 fe24 30                        TSX
0671 fe25 ee 00                     LDX    0,X
0672 fe27 31                        INS
0673 fe28 31                        INS
0674 fe29 a7 00                     STAA   0,X      LAST ONE IS ZERO
0675 fe2b 26 f6                     BNE    RESET3     BUT IT'S PLACED INTO ROM
