0763                         *        ENTRY: -- OPCODE IN A
0764                         *
0765                         *        EXIT: -- (B) = NUMBER OF BYTES IN INSTRUCTION
0766                         *
0767                         *        USES: -- A,B,C,X
0768 fe8f 36                 BYTCNT PSHA
0769 fe90 16                        TAB
0770 fe91 ce ff d7                  LDX    #OPTAB-1
0771 fe94 08                 BYT1   INX
0772 fe95 c0 08                     SUBB   #8
0773 fe97 24 fb                     BCC    BYT1
0774 fe99 a6 00                     LDAA   0,X
0775 fe9b 46                 BYT2   RORA
0776 fe9c 5c                        INCB
0777 fe9d 26 fc                     BNE    BYT2
0778 fe9f 32                        PULA
0779 fea0 25 1e                     BCS    BYT7
0780 fea2 81 30                     CMPA   #$30     CHECK FOR BRANCH
0781 fea4 24 04                     BCC    BYT3
0782 fea6 81 20                     CMPA   #$20
0783 fea8 24 14                     BCC    BYT5     IT IS A BRANch
0784 feaa 81 60              BYT3   CMPA   #$60
0785 feac 25 11                     BCS    BYT6     IT IS ONE BYTE
0786 feae 81 8d                     CMPA   #$8D
0787 feb0 27 0c                     BEQ    BYT5     IT IS BSR
0788 feb2 84 bd                     ANDA   #$BD
0789 feb4 81 8c                     CMPA   #$8C
0790 feb6 27 04                     BEQ    BYT4     IS X OR SP IMMEDIATE
0791 feb8 84 30                     ANDA   #$30     CHECK FOR THREE BYTES
0792 feba 81 30                     CMPA   #$30
0793 febc c2 ff              BYT4   SBCB   #$FF
0794 febe 5c                 BYT5   INCB
0795 febf 5c                 BYT6   INCB
0796 fec0 39                 BYT7   RTS
