0568 fd9c 81 0a              THB1   CMPA   #10
0569 fd9e 25 02                     BCS    THB2
0570 fda0 8b 07                     ADDA   #7
0571 fda2 8b 30              THB2   ADDA   #$30
0572 fda4 20 da              OUTCHB BRA    OUTCH    SHORT JUMP EXTENSION
