0724                         **     CMDEX - COMMAND EXECUTE SUBROUTINE
0725                         *
0726                         *        COMPUTES AN ADDRESS BASED ON COMMAND INPUT
0727                         *          AND JUMPS TO CORRESPONDING HANDLER
0728                         *
0729                         *        ENTRY:  RETURN ADDRESS ON STACK
0730                         *
0731                         *        EXIT:   TO COMMAND HANDLER
0732                         *                (B) = 0
0733                         *                (X) = USER STACK POINTER
0734                         *
0735                         *        USES:   ALL,TEMP,TEM1
0736                         
0737 fe72 8d 8e              CMDEX  BSR    OUTST2   SEND PROMPT
0738 fe74 bd fd 36                  JSR    INCH     GET COMMAND
0739 fe77 36                        PSHA
0740 fe78 4a                        DECA
0741 fe79 08                 CMDE1  INX
0742 fe7a a1 09                     CMPA   CMDDSP,X
0743 fe7c 25 fb                     BCS    CMDE1
0744 fe7e 26 ad                     BNE    MAINLP   ILLEGAL COMMAND
0745 fe80 bd fd 7e                  JSR    OUTSP
0746 fe83 32                        PULA
0747 fe84 e6 17                     LDAB   CMDTBL+CMDDSP,X
0748 fe86 37                        PSHB
0749 fe87 c6 fc                     LDAB   #ROMBAS/256
0750 fe89 37                        PSHB            HANDLER ADDRESS ON STACK
0751                         
