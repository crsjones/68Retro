0408                         **     INCH - INPUT CHARACTER FROM CONSOLE
0409                         *
0410                         *        ENTRY: NONE
0411                         *        EXIT:  (A) = ASCII VALUE; RUBOUTS MASKED
0412                         *
0413                         *        USES   A,C
0414                         
0415 fd36 b6 ee 08           INCH   LDAA   ACIASR   GET RX STATUS
0416 fd39 44                        LSRA            ROTATE RX BIT INTO C
0417 fd3a 24 fa                     BCC    INCH
0418 fd3c b6 ee 09                  LDAA   ACIADR   GET DATA
0419 fd3f 81 7f                     CMPA   #$7F     IGNORE RUBOUTS
0420 fd41 27 f3                     BEQ    INCH
0421 fd43 20 3b              OUTCHA BRA    OUTCH    SHORT JUMP EXTENSION
0422                         
0423                         **     IHB - INPUT HEX BYTES
0424                         *
0425                         *        ENTRY: (A) = CHECKSUM
0426                         *
0427                         *        EXIT:  (A) = CHECKSUM + NEW DIGIT
0428                         *               (B) = NEW DIGIT
0429                         
0430 fd45 36                 IHB    PSHA           CHECKSUM ONTO STACK
0431 fd46 8d 8a                     BSR    IHD      GET FIRST DIGIT
0432 fd48 24 a7                     BCC    LOAD7    ERROR RETURN
0433 fd4a 48                        ASLA
0434 fd4b 48                        ASLA
0435 fd4c 48                        ASLA
0436 fd4d 48                        ASLA
0437 fd4e 16                        TAB
0438 fd4f 8d 81                     BSR    IHD      GET SECOND DIGIT
0439 fd51 24 9e                     BCC    LOAD7
0440 fd53 1b                        ABA             COMBINE TWO DIGITS
0441 fd54 16                        TAB
0442 fd55 32                        PULA            GET CHECKSUM
0443 fd56 1b                        ABA             UPDATE CHECKSUM
0444 fd57 39                        RTS
0445                         
0446                         *      INPUT HEX DIGIT CONTINUED
0447                         
0448 fd58 80 f6              IHD2   SUBA   #-10
0449 fd5a 39                 IHD3   RTS             HEX RETURN
0450                         
0451                         **     TYPINS - TYPE ONE INSTRUCTION OR BYTE
0452                         *
0453                         *        ENTRY:   (X) = FWA INSTRUCTION OR BYTE
0454                         *                 (B) = < 0 THEN BYTE
0455                         *                       > 0  THEN INSTRUCTION
0456                         *
0457                         *        EXIT:    BYTE/INSTRUCTION TYPED ON NEW LINE
0458                         *                 (X) = ADDRES OF NEXT BYTE/INSTRUCTION
0459                         *
0460                         *        USES:    ALL, 'TEMP'
0461                         
0462 fd5b a6 00              TYPINS LDAA   0,X      GET MEMORY BYTE
0463 fd5d 36                        PSHA            OPCODE ONTO STACK
0464 fd5e 8d 46                     BSR    CRLF
0465 fd60 ce dd ee                  LDX    #TEMP
0466 fd63 8d 15                     BSR    OUT4HS
0467 fd65 32                        PULA
0468 fd66 5d                        TSTB            IS THIS INSTRUCTION MODE?
0469 fd67 2b 06                     BMI    TYPIN1   NO IT ISN'T
0470 fd69 bd fe 8f                  JSR    BYTCNT
0471 fd6c 5a                        DECB
0472 fd6d 2b 82                     BMI    LOAD7    NOT AN INSTRUCTION
0473 fd6f fe dd ee           TYPIN1 LDX    TEMP
0474 fd72 8d 08                     BSR    OUT2HS
0475                         
0476                         **     OUTREG - OUTPUT BYTE OR REGISTER
0477                         *
0478                         *        ENTRY: (X) = ADDRESS OF BYTE OR STORED REGISTER
0479                         *               (B) < 1 THEN NO BYTES TYPED
0480                         *                   = 1 THEN ONE BYTE TYPED
0481                         *                   > 2 THEN TWO BYTES TYPED
0482                         *
0483                         *        EXIT:  X INCREMENTED PAST BYTES(S)
0484                         *               (A) = ' '
0485                         *
0486                         *        USES:  A,B,C,X
0487                         
0488 fd74 c1 01              OUTREG CMPB   #1       HOW MANY MORE BYTES?
0489 fd76 2b 14                     BMI    OUT2
0490 fd78 27 02                     BEQ    OUT2HS
0491                         
0492                         **     OUT4HS - OUTPUT FOUR HEX DIGITS AND SPACE
0493                         *
0494                         *        ENTRY:   (X) = ADDRESS OF BYTES
0495                         *
