0517                         *
0518                         *        ENTRY: - (A) = ASCII VALUE OF CHARACTER
0519                         *
0520                         *        EXIT:  - (A) = ASCII VALUE
0521                         *
0522                         *        USES:    CCR EXCEPT 'C' BIT
0523                         
0524 fd80 37                 OUTCH  PSHB   
0525 fd81 c6 02                     LDAB   #2       MASK FOR ACIACR
0526 fd83 f5 ee 08           OUT1   BITB   ACIASR
0527 fd86 27 fb                     BEQ    OUT1
0528 fd88 b7 ee 09                  STAA   ACIADR   SEND (A) TO CONSOLE
0529 fd8b 33                        PULB
0530 fd8c 39                 OUT2   RTS
0531                         
