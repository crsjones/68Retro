0934                         
0935 ff70 33                 JPXH   PULB            GET OFFSET
0936 ff71 4f                        CLRA
0937 ff72 eb 05                     ADDB  5,X
0938 ff74 a9 04                     ADCA  4,X
0939 ff76 8c                        FCB   $8C       CPX#: ONE BYTE BRA NEWPC
0940 ff77 32                 JMPH   PULA
0941 ff78 33                        PULB
0942 ff79 a7 06              NEWPC  STAA  6,X
0943 ff7b e7 07                     STAB  7,X
0944 ff7d 20 d5                     BRA   BSTRD     RETURN TO CALLER
0945                         
0946                         **     RTSH - SUBROUTINE RETURN HANDLER
0947                         
0948 ff7f 08                 RTSH   INX
0949 ff80 08                        INX
0950 ff81 ff dd f0                  STX   USERS     NET PULL OF TWO BYTES
0951 ff84 a6 03              RTS1   LDAA  3,X       MOVE FIVE BYTES
0952 ff86 a7 05                     STAA  5,X
0953 ff88 09                        DEX
0954 ff89 5a                        DECB
0955 ff8a 2e f8                     BGT   RTS1
0956 ff8c 20 c6                     BRA   BSTRD
0957                         
0958                         **     RTIH - RETURN FROM INTERRUPT HANDLER
0959                         
0960 ff8e 08                 RTIH   INX
0961 ff8f 5a                        DECB
0962 ff90 2a fc                     BPL    RTIH
0963 ff92 20 bd                     BRA    STOX
0964                         
0965                         **     SWIH - SOFTWARE INTERRUPT HANDLER
0966                         
0967 ff94 a6 07              SWIH   LDAA   7,X
0968 ff96 a7 00                     STAA   0,X
0969 ff98 09                        DEX
0970 ff99 5a                        DECB
0971 ff9a 2a f8                     BPL    SWIH
0972 ff9c 8a 10                     ORAA   #%00010000  SET INTERUPT MASK
0973 ff9e a7 01                     STAA   1,X
0974 ffa0 ff dd f0                  STX    USERS
0975 ffa3 c6 fa                     LDAB   #-USWI/256*256+USWI  USWI LO ORDER
0976 ffa5 86 dd                     LDAA   #USWI/256
0977 ffa7 20 d0                     BRA    NEWPC     PATCH IN USER IRQ ADDRESS
0978                         
0979                         **     STRING TABLES
0980 ffa9 0d 0a 13 14 00 00  PMTMSG FCB    $D,$A,$13,$14,0,0,' ,'*,' +$80
     20 2a a0
0981 0009                    PMTMSGL EQU   *-PMTMSG
0982 ffb2 53 39              S9MSG  FCB    'S,'9
0983 ffb4 0d 0a 00 00 00 80  CRSTR  FCB    $D,$A,0,0,0,$80
0984 ffba 53 b1              S1MSG  FCB    'S,'1+$80
0985                         
0986                         **     COMMAND TABLE
0987                         
0988 ffbc                    CMDTAB EQU    *
0989                         
0990 0009                    CMDDSP EQU    CMDTAB-PMTMSG-PMTMSGL-1
0991 ffbc 52                        FCB    'S-1    SINGLE STEP
0992 ffbd 51                        FCB    'R-1    PRINT REGISTERS
0993 ffbe 4f                        FCB    'P-1    PUNCH MEMORY
0994 ffbf 4c                        FCB    'M-1    DISPLAY/ALTER MEMORY
0995 ffc0 4b                        FCB    'L-1    LOAD MEMORY
0996 ffc1 48                        FCB    'I-1    DISPLAY INSTRUCTIONS
0997 ffc2 46                        FCB    'G-1    GO TO USERS PROGRAM
0998 ffc3 43                        FCB    'D-1    DUMP MEMORY
0999 ffc4 17                        FCB    $18-1    CTL-X - DISPLAY X REGISTER
1000 ffc5 0f                        FCB    $10-1    CTL-P - DISPLAY P REGISTER
1001 ffc6 0b                        FCB    $C-1     CTL-L - CASSETTE LOAD
1002 ffc7 02                        FCB    3-1      CTL-C - DISPLAY C REGISTER
1003 ffc8 01                        FCB    2-1      CTL-B - DISPLAY B REGISTER
1004 ffc9 00                        FCB    1-1      CTL-A - DISPLAY A REGISTER
1005 000e                    CMDTBL EQU    *-CMDTAB
